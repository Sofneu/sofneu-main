    "faq_tabs_mKhqgV": {
      "type": "faq-tabs",
      "blocks": {
        "faq_hHRt6R": {
          "type": "faq",
          "settings": {
            "show_item": true,
            "category": "tab_1",
            "question": "How do I choose the right tights thickness?",
            "answer": "<p>Choose based on your desired coverage, warmth, and occasion. Ultra Sheer (10D) offers a barely-there feel for warm days, Sheer (20D) balances elegance and everyday wear, Semi-Opaque (40D) provides more coverage with a refined matte finish, and Opaque (80D+) delivers extra warmth for colder weather.</p>",
            "default_open": false
          }
        },
        "faq_mr4c73": {
          "type": "faq",
          "settings": {
            "show_item": true,
            "category": "tab_1",
            "question": "What is the difference between Ultra Sheer, Sheer, Semi-Opaque, and Opaque tights?",
            "answer": "<p>The main difference is coverage, warmth, and durability. Lower denier styles feel lighter and more invisible, while higher denier styles provide more coverage, warmth, and everyday durability.</p>",
            "default_open": false
          }
        },
        "faq_EHwrKc": {
          "type": "faq",
          "settings": {
            "show_item": true,
            "category": "tab_1",
            "question": "Which tights are best for everyday wear?",
            "answer": "<p>For everyday wear, we recommend 20D–40D tights. They offer the ideal balance of comfort, coverage, and durability for work, daily outfits, and versatile styling.</p>",
            "default_open": false
          }
        },
        "faq_m9jhTq": {
          "type": "faq",
          "settings": {
            "show_item": true,
            "category": "tab_2",
            "question": "How do I choose my tights size?",
            "answer": "<p>Choose your size based on your height and weight using our size guide. If you are between sizes, we recommend choosing the larger size for a more comfortable fit and easier movement.</p>",
            "default_open": false
          }
        },
        "faq_dEJEbe": {
          "type": "faq",
          "settings": {
            "show_item": true,
            "category": "tab_2",
            "question": "Will tights stay in place while wearing?",
            "answer": "<p>Yes. Our adaptive stretch and thoughtfully designed waistband help create a secure, second-skin fit that moves naturally with your body.</p>",
            "default_open": false
          }
        },
        "faq_9PXL8n": {
          "type": "faq",
          "settings": {
            "show_item": true,
            "category": "tab_2",
            "question": "Are tights comfortable for all-day wear?",
            "answer": "<p>Yes. Sofneu tights are designed with soft, flexible yarns and a comfortable waistband to provide lightweight comfort from morning to night.</p>",
            "default_open": false
          }
        },
        "faq_faphMC": {
          "type": "faq",
          "settings": {
            "show_item": true,
