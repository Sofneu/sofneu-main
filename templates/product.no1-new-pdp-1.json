    "custom_liquid_Bf444n": {
      "type": "custom-liquid",
      "name": "comparison",
      "settings": {
        "custom_liquid": "<section class=\"eros-compare\">\n  <style>\n    .eros-compare{\n      --table-max: 1000px;      /* 表格最大宽度 */\n      --fs: 16px;              /* PC 字号 */\n      --fs-sm: 12px;           /* 移动端字号 */\n      --pad-y: 12px;           /* 行间距（上下内边距） */\n      --pad-x: 14px;           /* 左右内边距 */\n      --pad-y-sm: 8px;\n      --pad-x-sm: 8px;\n      --row-alt: #F5F2EB;      /* ✅ 斑马纹底色（关闭可改为 transparent） */\n      --chip-bg: #E9E6E4;      /* 标签底色 */\n      --good:#10b981; --bad:#ef4444; --warn:#f59e0b;\n      --text:#111827;\n    }\n\n    .eros-compare{\n      font-family:system-ui,-apple-system,\"Segoe UI\",Roboto,Arial;\n      color:var(--text);\n    }\n    .eros-compare .table-wrap{\n      max-width:var(--table-max);\n      margin:0 auto;\n      overflow-x:auto;\n    }\n    .eros-compare table{\n      width:100%;\n      border-collapse:collapse;\n    }\n    .eros-compare th,.eros-compare td{\n      padding:var(--pad-y) var(--pad-x);\n      font-size:var(--fs);\n      text-align:left;\n      line-height:1.5;\n      border:0;\n      white-space:nowrap;\n    }\n    .eros-compare thead th{font-weight:700}\n    .eros-compare .feat{font-weight:600}\n    .eros-compare tbody tr:nth-child(odd){\n      background:var(--row-alt);  /* ✅ 控制斑马纹色 */\n    }\n\n    /* 标签样式 */\n    .chip{\n      display:inline-flex;\n      align-items:center;\n      gap:6px;\n      padding:5px 9px;\n      border-radius:999px;\n      background:var(--chip-bg);\n      font-size:0.85em;\n    }\n    .chip i{font-style:normal}\n    .ok i{color:var(--good)}\n    .bad i{color:var(--bad)}\n    .warn i{color:var(--warn)}\n    .value{font-weight:600}\n\n    /* 移动端字体、间距缩小 */\n    @media (max-width: 750px){\n      .eros-compare th,.eros-compare td{\n        font-size:var(--fs-sm);\n        padding:var(--pad-y-sm) var(--pad-x-sm);\n        white-space:normal;\n      }\n    }\n  </style>\n\n  <div class=\"table-wrap\">\n    <table>\n      <thead>\n        <tr>\n          <th>Feature</th>\n          <th>Low-End</th>\n          <th>Sofneu</th>\n          <th>High-End</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr>\n          <td class=\"feat\">Waist Stay</td>\n          <td><span class=\"chip bad\"><i>❌</i> Slips</span></td>\n          <td><span class=\"chip ok\"><i>✅</i> Perfect</span></td>\n          <td><span class=\"chip ok\"><i>✅</i> Good</span></td>\n        </tr>\n        <tr>\n          <td class=\"feat\">Control Top</td>\n          <td><span class=\"chip bad\"><i>❌</i> None</span></td>\n          <td><span class=\"chip ok\"><i>✅</i> Smooth</span></td>\n          <td><span class=\"chip warn\"><i>⚠️</i> Firm</span></td>\n        </tr>\n        <tr>\n          <td class=\"feat\">Comfort</td>\n          <td><span class=\"chip bad\"><i>❌</i> Rough</span></td>\n          <td><span class=\"chip ok\"><i>✅</i> Silky</span></td>\n          <td><span class=\"chip warn\"><i>⚠️</i> Heavy</span></td>\n        </tr>\n        <tr>\n          <td class=\"feat\">Elasticity</td>\n          <td><span class=\"chip bad\"><i>❌</i> Weak</span></td>\n          <td><span class=\"chip ok\"><i>✅</i> Superior</span></td>\n          <td><span class=\"chip ok\"><i>✅</i> Good</span></td>\n        </tr>\n        <tr>\n          <td class=\"feat\">Durability</td>\n          <td><span class=\"chip bad\"><i>❌</i> Fragile</span></td>\n          <td><span class=\"chip ok\"><i>✅</i> Resistant</span></td>\n          <td><span class=\"chip warn\"><i>⚠️</i> Thick</span></td>\n        </tr>\n        <tr>\n          <td class=\"feat\">Finish</td>\n          <td><span class=\"chip bad\"><i>❌</i> Dull</span></td>\n          <td><span class=\"chip ok\"><i>✅</i> Versatile</span></td>\n          <td><span class=\"chip ok\"><i>✅</i> Glossy</span></td>\n        </tr>\n        <tr>\n          <td class=\"feat value\">Value</td>\n          <td class=\"value\">AUD $15</td>\n          <td class=\"value\">AUD $25</td>\n          <td class=\"value\">AUD $60</td>\n        </tr>\n      </tbody>\n    </table>\n  </div>\n</section>"
      }
