{"sections":{"main":{"type":"main-page","disabled":true,"settings":{"compact-size-enabled":true,"size_heading":140,"size_heading_mobile":100,"color-body-text":"rgba(0,0,0,0)","color-bg-overlay":"rgba(0,0,0,0)","color-overlay-opacity":100,"margin-top":40,"margin-bottom":0}},"rich_text_bBgp9t":{"type":"rich-text","blocks":{"heading_xyFLNQ":{"type":"heading","settings":{"heading":"A Simple Guide to Comfort and Fit","disable_on_mobile":false,"size_heading":100,"size_heading_mobile":100}},"text_T7Cgbc":{"type":"text","settings":{"text":"<p><em>Discover how small details — fabric, thickness, and design — shape how your tights look, feel, and move.<\/em><\/p>","disable_on_mobile":false}}},"block_order":["heading_xyFLNQ","text_T7Cgbc"],"name":"t:sections.rich-text.presets.name","settings":{"section_width":"regular","desktop_text_horizontal_position":"center","color-body-text":"rgba(0,0,0,0)","background_color":"rgba(0,0,0,0)","margin-top":0,"margin-bottom":0}},"image_with_text_WX4eNJ":{"type":"image-with-text","blocks":{"heading_bGVLHw":{"type":"heading","settings":{"heading":"We tried them all.","disable_on_mobile":false,"size_heading":100,"size_heading_mobile":100}},"text_fVz7VF":{"type":"text","settings":{"text":"<ul><li>Tights are part of daily life for many women, yet few realize how much small details matter. <\/li><li>At Eros, we believe comfort begins with understanding.<\/li><\/ul>","text_style":"body","disable_on_mobile":false}}},"block_order":["heading_bGVLHw","text_fVz7VF"],"name":"t:sections.image-with-text.presets.name","settings":{"title":"Why Understanding Pantyhose Matters","layout":"image_first","desktop-percentage-image-width":50,"full-width-enabled":false,"slide_height":"fixed_height","desktop_fixed_height":320,"mobile_fixed_height":460,"section-color-body-text":"rgba(0,0,0,0)","section-color-overlay":"rgba(0,0,0,0)","section-color-overlay-opacity":100,"color-body-text":"rgba(0,0,0,0)","color-overlay":"rgba(0,0,0,0)","color-overlay-opacity":100,"desktop_text_vertical_position":"center","desktop_text_horizontal_position":"left","mobile_text_horizontal_position":"left","margin-top":0,"margin-bottom":20}},"image_with_text_pF8ziP":{"type":"image-with-text","blocks":{"subheading_CyNVa3":{"type":"subheading","settings":{"subheading":"Find your perfect balance","subheading_disable_on_mobile":false}},"text_KXeyij":{"type":"text","settings":{"text":"<ul><li>Denier measures fiber thickness — the weight (in grams) of 9,000 meters of yarn<\/li><li>Smaller number → finer, lighter, more transparent.<\/li><\/ul>","text_style":"body","disable_on_mobile":false}}},"block_order":["subheading_CyNVa3","text_KXeyij"],"custom_css":[],"name":"t:sections.image-with-text.presets.name","settings":{"title":"Understanding Denier","layout":"text_first","desktop-percentage-image-width":50,"full-width-enabled":false,"slide_height":"adapt_to_first_image","desktop_fixed_height":320,"mobile_fixed_height":460,"section-color-body-text":"rgba(0,0,0,0)","section-color-overlay":"rgba(0,0,0,0)","section-color-overlay-opacity":100,"color-body-text":"rgba(0,0,0,0)","color-overlay":"rgba(0,0,0,0)","color-overlay-opacity":100,"desktop_image":"shopify:\/\/shop_images\/denier_different.png","desktop_text_vertical_position":"center","desktop_text_horizontal_position":"left","mobile_text_horizontal_position":"left","margin-top":20,"margin-bottom":20}},"custom_liquid_PiyCLJ":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"custom_liquid":"<section class=\"denier-block\">\n  <style>\n    \/* === 可调参数（主要改这里） === *\/\n    .denier-block{\n      --maxw: 1840px;       \/* PC 最大宽度 *\/\n      --fs-title: 20px;     \/* 标题字号 *\/\n      --fs-sub: 14px;       \/* 副标题字号 *\/\n      --fs-head: 14px;      \/* 表头字号 *\/\n      --fs-body: 15px;      \/* 表格正文字号 *\/\n\n      --pad-y: 10px;        \/* 单元格上下内边距（PC） *\/\n      --pad-x: 16px;        \/* 单元格左右内边距（PC） *\/\n\n      --pad-y-sm: 8px;      \/* 单元格上下内边距（移动） *\/\n      --pad-x-sm: 10px;     \/* 单元格左右内边距（移动） *\/\n\n      --row-alt: #b3877b;   \/* 斑马纹行底色 *\/\n      --border: #b3877b;    \/* 表格边线颜色 *\/\n      --text: #2B2B2B;      \/* 正文文字颜色 *\/\n      --muted: #2B2B2B;     \/* 次要文字颜色 *\/\n      --hint: #2B2B2B;      \/* 提示文字颜色 *\/\n      --bg: #FFFFFF;        \/* 整块淡背景 *\/\n    }\n\n    .block .denier-wrap{\n      max-width: var(--maxw);\n      margin: 0 auto;\n      padding: 32px 16px 40px;\n      background: var(--bg);\n      border-radius: 18px;\n      border: 1px solid #FFFFFF;\n    }\n\n    .denier-block h3{\n      margin: 0 0 4px;\n      text-align: center;\n      line-height: 1.3;\n      color: var(--text);\n    }\n\n    .denier-block .sub{\n      margin: 0 0 10px;\n      font-size: 1em;\n      font-style: italic;\n      text-align: center;\n      color: var(--muted);\n    }\n\n    .denier-block .hint{\n      margin: 0 0 18px;\n      font-size: 13px;\n      color: var(--hint);\n      font-style: italic;\n    }\n\n    .denier-table-wrap{\n      width: 80%;\n      margin: 0 auto;\n      overflow-x: auto;\n      -webkit-overflow-scrolling: touch;\n    }\n\n    .denier-table{\n      width: 100%;\n      margin: 0 auto;\n      border-collapse: collapse;\n      min-width: 720px; \/* 控制横拉宽度，觉得太宽\/太窄可以改 *\/\n      font-size: var(--fs-body);\n      color: var(--text);\n    }\n\n    .denier-table thead th{\n      font-size: var(--fs-head);\n      font-weight: 600;\n      text-align: left;\n      padding: var(--pad-y) var(--pad-x);\n      border-bottom: 1px solid var(--border);\n      white-space: nowrap;\n    }\n\n    .denier-table tbody td{\n      padding: var(--pad-y) var(--pad-x);\n      border-bottom: 1px solid #FFFFFF;\n      white-space: nowrap;\n    }\n\n    .denier-table tbody tr:nth-child(even){\n      background: var(--row-alt);\n    }\n\n    .denier-table .type-cell{\n      font-weight: 500;\n    }\n\n    \/* 星级样式 *\/\n    .denier-stars{\n      letter-spacing: 2px;\n      font-size: 14px;\n    }\n\n    \/* === 移动端微调 === *\/\n    @media (max-width: 749px){\n      .denier-block .wrap{\n        padding: 24px 12px 28px;\n        border-radius: 0;           \/* 如果你想和主题完全贴合，可以改成 0 *\/\n      }\n\n      .denier-block h3{\n        font-size: 18px;\n        text-align: center;\n      }\n\n      .denier-block .sub{\n        font-size: 1em;\n        font-style: italic;\n        text-align: center;\n      }\n\n      .denier-table{\n        min-width: 640px;          \/* 移动端横拉的最小宽度 *\/\n        font-size: 14px;\n      }\n\n      .denier-table thead th,\n      .denier-table tbody td{\n        padding: var(--pad-y-sm) var(--pad-x-sm);\n      }\n    }\n  <\/style>\n\n  <div class=\"wrap denier-wrap\">\n    <h3>Find Your Perfect Denier<\/h3>\n    <p class=\"sub\">Choosing thickness helps balance comfort, warmth, and appearance.<\/p>\n\n    <div class=\"denier-table-wrap\">\n      <table class=\"denier-table\" aria-label=\"Denier comparison table\">\n        <thead>\n          <tr>\n            <th>Tights Type<\/th>\n            <th>Denier<\/th>\n            <th>Temp.<\/th>\n            <th>Durability<\/th>\n            <th>Breathability<\/th>\n          <\/tr>\n        <\/thead>\n        <tbody>\n          <tr>\n            <td class=\"type-cell\">Sheer<\/td>\n            <td>10D<\/td>\n            <td>22–30°C<\/td>\n            <td><span class=\"denier-stars\">★☆☆☆☆<\/span><\/td>\n            <td><span class=\"denier-stars\">★★★★★<\/span><\/td>\n          <\/tr>\n          <tr>\n            <td class=\"type-cell\">Sheer<\/td>\n            <td>20D<\/td>\n            <td>18–26°C<\/td>\n            <td><span class=\"denier-stars\">★★☆☆☆<\/span><\/td>\n            <td><span class=\"denier-stars\">★★★★☆<\/span><\/td>\n          <\/tr>\n          <tr>\n            <td class=\"type-cell\">Opaque<\/td>\n            <td>40D<\/td>\n            <td>15–22°C<\/td>\n            <td><span class=\"denier-stars\">★★★☆☆<\/span><\/td>\n            <td><span class=\"denier-stars\">★★★☆☆<\/span><\/td>\n          <\/tr>\n          <tr>\n            <td class=\"type-cell\">Opaque<\/td>\n            <td>50D<\/td>\n            <td>10–18°C<\/td>\n            <td><span class=\"denier-stars\">★★★★☆<\/span><\/td>\n            <td><span class=\"denier-stars\">★★☆☆☆<\/span><\/td>\n          <\/tr>\n          <tr>\n            <td class=\"type-cell\">Thermal<\/td>\n            <td>100D<\/td>\n            <td>0–12°C<\/td>\n            <td><span class=\"denier-stars\">★★★★★<\/span><\/td>\n            <td><span class=\"denier-stars\">★☆☆☆☆<\/span><\/td>\n          <\/tr>\n        <\/tbody>\n      <\/table>\n    <\/div>\n  <\/div>\n<\/section>"}},"rich_text_iybgpb":{"type":"rich-text","blocks":{"heading_gCkj8r":{"type":"heading","settings":{"heading":"Understanding Fabric","disable_on_mobile":false,"size_heading":100,"size_heading_mobile":100}},"text_RXHj3B":{"type":"text","settings":{"text":"<p><em>The fabric decides how your tights feel, breathe, and last.<\/em><\/p>","disable_on_mobile":false}}},"block_order":["heading_gCkj8r","text_RXHj3B"],"name":"t:sections.rich-text.presets.name","settings":{"section_width":"regular","desktop_text_horizontal_position":"center","color-body-text":"rgba(0,0,0,0)","background_color":"rgba(0,0,0,0)","margin-top":0,"margin-bottom":0}},"custom_liquid_NPKGE6":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"custom_liquid":"<section class=\"basic-comp\">\n  <style>\n    .basic-comp{\n      \/* —— 可调参数 —— *\/\n      --maxw: 1840px;          \/* 整块最大宽度，不想太宽就改这里 *\/\n      --fs-title: 20px;\n      --fs-sub: 14px;\n      --fs-name: 15px;\n      --fs-body: 14px;\n\n      --icon-size: 56px;      \/* 圆形 icon 尺寸：直径 *\/\n      --icon-bg: #F5F2EC;     \/* icon 背景色 *\/\n      --card-bg: #FBF9F6;\n      --border: #E4DED4;\n      --text: #111827;\n      --muted: #6B7280;\n      --shadow: 0 4px 14px rgba(0,0,0,.05);\n    }\n\n    .basic-comp .wrap{\n      max-width: var(--maxw);\n      margin: 0 auto;\n      padding: 32px 16px 40px;\n    }\n\n    .basic-comp h3{\n      margin: 0 0 6px;\n      font-size: var(--fs-title);\n      line-height: 1.3;\n      color: var(--text);\n    }\n\n    .basic-comp .sub{\n      margin: 0 0 24px;\n      font-size: var(--fs-sub);\n      color: var(--muted);\n    }\n\n    \/* === 上半部：3 个小卡片 === *\/\n    .mat-grid{\n      display: grid;\n      grid-template-columns: repeat(3, minmax(0,1fr));\n      gap: 18px;\n      margin-bottom: 24px;\n    }\n\n    .mat-card{\n      background: var(--card-bg);\n      border-radius: 14px;\n      border: 1px solid var(--border);\n      padding: 18px 16px 16px;\n      box-shadow: var(--shadow);\n      text-align: center;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      gap: 10px;\n    }\n\n    .mat-icon{\n      width: var(--icon-size);\n      height: var(--icon-size);\n      border-radius: 999px;\n      background: var(--icon-bg);\n      display: grid;\n      place-items: center;\n      overflow: hidden;\n    }\n\n    .mat-icon img{\n      width: 70%;\n      height: 70%;\n      object-fit: contain;\n      display: block;\n    }\n\n    .mat-name{\n      font-size: var(--fs-name);\n      font-weight: 600;\n      color: var(--text);\n    }\n\n    .mat-fn{\n      font-size: var(--fs-body);\n      color: var(--muted);\n      line-height: 1.5;\n    }\n\n    \/* === 下半部：结论块 === *\/\n    .mat-conclusion{\n      margin-top: 8px;\n      padding: 16px 18px 14px;\n      border-radius: 14px;\n      background: #F3F4F6;\n      border: 1px solid #E2E4EA;\n    }\n\n    .mat-conclusion-title{\n      margin: 0 0 10px;\n      font-size: 15px;\n      font-weight: 600;\n      color: var(--text);\n    }\n\n    .mat-conclusion-list{\n      margin: 0;\n      padding-left: 16px;\n      list-style: none;\n      font-size: var(--fs-body);\n      color: var(--text);\n    }\n\n    .mat-conclusion-list li{\n      position: relative;\n      margin-bottom: 6px;\n      line-height: 1.6;\n    }\n\n    .mat-conclusion-list li::before{\n      content: \"\";\n      position: absolute;\n      left: -12px;\n      top: 0.9em;\n      width: 4px;\n      height: 4px;\n      border-radius: 999px;\n      background: #3B82F6; \/* 小蓝点 *\/\n      transform: translateY(-50%);\n    }\n\n    .mat-note{\n      font-size: 13px;\n      color: var(--muted);\n      margin-top: 6px;\n    }\n\n    \/* === 移动端 === *\/\n    @media (max-width: 749px){\n      .basic-comp .wrap{\n        padding: 24px 12px 32px;\n      }\n\n      .basic-comp h3{\n        font-size: 18px;\n      }\n\n      .mat-grid{\n        grid-template-columns: 1fr;\n        gap: 12px;\n      }\n\n      .mat-card{\n        padding: 16px 14px;\n        align-items: flex-start;\n        text-align: left;\n        flex-direction: row;\n        gap: 12px;\n      }\n\n      .mat-text{\n        display: flex;\n        flex-direction: column;\n        gap: 4px;\n      }\n\n      .mat-icon{\n        flex-shrink: 0;\n      }\n    }\n  <\/style>\n\n  <div class=\"wrap rte\">\n    <h3>Basic Composition<\/h3>\n    <p class=\"sub\">Every pair blends structure, stretch, and softness.<\/p>\n\n    <div class=\"mat-grid\">\n      <!-- Nylon -->\n      <article class=\"mat-card\">\n        <div class=\"mat-icon\">\n          <!-- 换成 Nylon 的圆形 icon：建议 512×512 透明 PNG -->\n          <img src=\"https:\/\/cdn.shopify.com\/s\/files\/…\/nylon-icon.png\" alt=\"Nylon icon\">\n        <\/div>\n        <div class=\"mat-text\">\n          <div class=\"mat-name\">Nylon<\/div>\n          <div class=\"mat-fn\">Adds structure and a subtle sheen.<\/div>\n        <\/div>\n      <\/article>\n\n      <!-- Spandex -->\n      <article class=\"mat-card\">\n        <div class=\"mat-icon\">\n          <img src=\"https:\/\/cdn.shopify.com\/s\/files\/…\/spandex-icon.png\" alt=\"Spandex icon\">\n        <\/div>\n        <div class=\"mat-text\">\n          <div class=\"mat-name\">Spandex<\/div>\n          <div class=\"mat-fn\">Provides stretch and lasting comfort.<\/div>\n        <\/div>\n      <\/article>\n\n      <!-- Cotton -->\n      <article class=\"mat-card\">\n        <div class=\"mat-icon\">\n          <img src=\"https:\/\/cdn.shopify.com\/s\/files\/…\/cotton-icon.png\" alt=\"Cotton icon\">\n        <\/div>\n        <div class=\"mat-text\">\n          <div class=\"mat-name\">Cotton<\/div>\n          <div class=\"mat-fn\">Adds localized softness and breathability.<\/div>\n        <\/div>\n      <\/article>\n    <\/div>\n\n    <!-- 结论块 -->\n    <div class=\"mat-conclusion\">\n      <p class=\"mat-conclusion-title\">Material balance<\/p>\n      <ul class=\"mat-conclusion-list\">\n        <li>Higher <strong>nylon<\/strong> content → more structure and a sleeker silhouette.<\/li>\n        <li>Higher <strong>spandex<\/strong> content → softer, more flexible comfort.<\/li>\n      <\/ul>\n      <p class=\"mat-note\">Each Eros blend is tuned to keep legs supported without feeling tight or heavy.<\/p>\n    <\/div>\n  <\/div>\n<\/section>"}},"custom_liquid_XBQnJV":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"custom_liquid":"<section class=\"yarn-block\">\n  <style>\n    .yarn-block{\n      \/* —— 控制参数 —— *\/\n      --maxw: 1840px;\n      --gap: 28px;\n      --pad: 22px;\n      --radius: 18px;\n      --card-bg: #F8F6F4;\n      --bd: #E5E1DC;\n      --muted: #6B6B6B;\n      --title: #1B1B1B;\n\n      --good: #0FA968;\n      --bad: #64748B;\n\n      --icon-box: 260px;     \/* 图区域高度（大图） *\/\n      --icon-size: 160px;    \/* PNG 图实际大小 *\/\n\n      --fs-h3: 1.4rem;\n      --fs-sub: 1rem;\n      --fs-name: 1.15rem;\n      --fs-body: .98rem;\n      --fs-cost: .82rem;\n\n      --shadow: 0 6px 20px rgba(0,0,0,.06);\n    }\n\n    .yarn-block .page-width{\n      max-width: var(--maxw);\n      margin: 0 auto;\n      padding: 60px 24px;\n    }\n\n    \/* 标题 *\/\n    .yarn-block .head{\n      margin-bottom: 32px;\n    }\n    .yarn-block h3{\n      margin: 0 0 6px;\n      font-size: var(--fs-h3);\n      color: var(--title);\n      font-weight: 700;\n    }\n    .yarn-block .sub{\n      margin: 0;\n      font-size: var(--fs-sub);\n      color: var(--muted);\n      line-height: 1.5;\n    }\n\n    \/* 卡片布局 *\/\n    .yarn-grid{\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: var(--gap);\n    }\n\n    .yarn-card{\n      background: var(--card-bg);\n      border: 1px solid var(--bd);\n      border-radius: var(--radius);\n      padding: var(--pad);\n      box-shadow: var(--shadow);\n\n      display: flex;\n      flex-direction: column;\n      transition: .2s ease;\n    }\n\n    .yarn-card:hover{\n      transform: translateY(-3px);\n      box-shadow: 0 12px 30px rgba(0,0,0,.1);\n    }\n\n    \/* 大图 Icon *\/\n    .yarn-icon{\n      height: var(--icon-box);\n      width: 100%;\n      border-radius: 14px;\n      background: #fff;\n      border: 1px solid var(--bd);\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      margin-bottom: 20px;\n      overflow: hidden;\n    }\n    .yarn-icon img{\n      width: var(--icon-size);\n      height: var(--icon-size);\n      object-fit: contain;\n      display: block;\n    }\n\n    \/* 名称 *\/\n    .yarn-name{\n      font-size: var(--fs-name);\n      font-weight: 700;\n      text-align: center;\n      margin-bottom: 10px;\n      color: var(--title);\n    }\n\n    \/* 分割线 *\/\n    .yarn-div{\n      height: 1px;\n      background: var(--bd);\n      margin: 10px 0 16px;\n      width: 100%;\n    }\n\n    \/* 要点 *\/\n    .yarn-points{\n      display: grid;\n      gap: 10px;\n      margin-bottom: 22px;\n    }\n    .yarn-point{\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      font-size: var(--fs-body);\n      line-height: 1.45;\n      color: var(--title);\n    }\n    .yarn-point .dot{\n      width: 9px;\n      height: 9px;\n      border-radius: 999px;\n      background: var(--bad);\n      flex: none;\n      margin-top: 2px; \/* 修复 PC 对齐问题 *\/\n    }\n    .yarn-point.good .dot{\n      background: var(--good);\n    }\n\n    \/* COST LEVEL：同一行 *\/\n    .yarn-cost{\n      width: 100%;\n      margin-top: auto;\n      padding-top: 16px;\n      border-top: 1px dashed var(--bd);\n\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      gap: 14px;\n    }\n\n    .cost-label{\n      text-transform: uppercase;\n      font-size: var(--fs-cost);\n      letter-spacing: .09em;\n      color: var(--muted);\n      flex: none;\n      font-weight: 600;\n    }\n\n    .cost-bar{\n      display: flex;\n      gap: 6px;\n    }\n\n    .cost-dot{\n      width: 10px;\n      height: 10px;\n      border-radius: 999px;\n      background: #DBE2EA;   \/* 未激活 *\/\n    }\n    .cost-dot.filled{\n      background: #1A1F2A;   \/* 激活 *\/\n    }\n\n    \/* —— Mobile —— *\/\n    @media(max-width: 749px){\n      .yarn-grid{\n        grid-template-columns: 1fr;\n        gap: 20px;\n      }\n      .yarn-block .page-width{\n        padding: 40px 16px;\n      }\n      .yarn-block{\n        --icon-box: 200px;\n        --icon-size: 140px;\n      }\n    }\n  <\/style>\n\n  <div class=\"page-width rte\">\n    <div class=\"head\">\n      <h3>Yarn Type<\/h3>\n      <p class=\"sub\">Different yarns create different touch and durability.<\/p>\n    <\/div>\n\n    <div class=\"yarn-grid\">\n\n      <!-- Covered Yarn -->\n      <article class=\"yarn-card\">\n        <div class=\"yarn-icon\">\n          <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0742\/4265\/4489\/files\/vernal-test.png?v=1763017189\" alt=\"Covered Yarn icon\">\n        <\/div>\n\n        <div class=\"yarn-name\">Covered Yarn<\/div>\n        <div class=\"yarn-div\"><\/div>\n\n        <div class=\"yarn-points\">\n          <div class=\"yarn-point good\"><span class=\"dot\"><\/span>High transparency<\/div>\n          <div class=\"yarn-point\"><span class=\"dot\"><\/span>Less refined texture<\/div>\n        <\/div>\n\n        <div class=\"yarn-cost\">\n          <span class=\"cost-label\">Cost Level<\/span>\n          <div class=\"cost-bar\">\n            <span class=\"cost-dot filled\"><\/span>\n            <span class=\"cost-dot filled\"><\/span>\n            <span class=\"cost-dot\"><\/span>\n            <span class=\"cost-dot\"><\/span>\n            <span class=\"cost-dot\"><\/span>\n          <\/div>\n        <\/div>\n      <\/article>\n\n      <!-- Velvet Yarn -->\n      <article class=\"yarn-card\">\n        <div class=\"yarn-icon\">\n          <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0742\/4265\/4489\/files\/vernal-test.png?v=1763017189\" alt=\"Velvet Yarn icon\">\n        <\/div>\n\n        <div class=\"yarn-name\">Velvet Yarn<\/div>\n        <div class=\"yarn-div\"><\/div>\n\n        <div class=\"yarn-points\">\n          <div class=\"yarn-point good\"><span class=\"dot\"><\/span>Soft & smooth<\/div>\n          <div class=\"yarn-point\"><span class=\"dot\"><\/span>Lower breathability<\/div>\n        <\/div>\n\n        <div class=\"yarn-cost\">\n          <span class=\"cost-label\">Cost Level<\/span>\n          <div class=\"cost-bar\">\n            <span class=\"cost-dot filled\"><\/span>\n            <span class=\"cost-dot filled\"><\/span>\n            <span class=\"cost-dot filled\"><\/span>\n            <span class=\"cost-dot\"><\/span>\n            <span class=\"cost-dot\"><\/span>\n          <\/div>\n        <\/div>\n      <\/article>\n\n      <!-- EROS Yarn -->\n      <article class=\"yarn-card\">\n        <div class=\"yarn-icon\">\n          <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0742\/4265\/4489\/files\/vernal-test.png?v=1763017189\" alt=\"EROS Yarn icon\">\n        <\/div>\n\n        <div class=\"yarn-name\">EROS Yarn<\/div>\n        <div class=\"yarn-div\"><\/div>\n\n        <div class=\"yarn-points\">\n          <div class=\"yarn-point good\"><span class=\"dot\"><\/span>Breathable & refined<\/div>\n          <div class=\"yarn-point\"><span class=\"dot\"><\/span>Higher production cost<\/div>\n        <\/div>\n\n        <div class=\"yarn-cost\">\n          <span c