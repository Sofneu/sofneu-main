    "collapsible_menu_tMPhmg": {
      "type": "collapsible_menu",
      "blocks": {
        "collapsible_tab_zmEBQp": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Shipping Carriers",
            "content": "<p>We use trusted delivery partners to ship Sofneu orders. The carrier used depends on the destination and shipping service selected:</p><ul><li><strong>Standard Shipping:</strong> AU Post or Aramex</li><li><strong>Express Shipping:</strong> AU Post Express</li><li><strong>New Zealand Shipping:</strong> AU  Post International</li></ul><p>For Standard Shipping within Australia, the carrier is selected by Sofneu based on the delivery location and available shipping services.</p><p>Tracking information will be provided once your order has been dispatched.</p>",
            "page": "",
            "icon": "none",
            "icon_advanced_settings": false,
            "icon_height_desktop": 28,
            "icon_height": 27,
            "icon_margin_desktop": 0,
            "icon_margin": 0,
            "open_by_default": false
          }
        },
        "collapsible_tab_nURMQc": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Order Processing",
            "content": "<p>Orders are typically processed and dispatched within <strong>1–2 business days</strong> after your order is successfully placed.</p><p>Orders placed on weekends or public holidays will generally begin processing on the next business day.</p><p>During peak periods, major promotions or public holidays, processing may occasionally take longer.</p><p>Once your order has been dispatched, you will receive a shipping confirmation email with tracking information where available.</p>",
            "page": "",
            "icon": "none",
            "icon_advanced_settings": false,
            "icon_height_desktop": 28,
            "icon_height": 27,
            "icon_margin_desktop": 0,
            "icon_margin": 0,
            "open_by_default": false
          }
        },
        "collapsible_tab_eFtrhU": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "New Zealand Duties and Taxes",
            "content": "<p>For most orders valued at <strong>NZ$1,000 or less</strong>, New Zealand Customs generally does not collect duty or GST from the customer at the border.</p><p>Taxes, duties, customs charges or other fees may apply in certain circumstances, including where applicable thresholds are exceeded or where required by New Zealand law.</p><p>Any taxes collected by Sofneu at checkout, where applicable, will be displayed as part of your order before payment.</p>",
            "page": "",
            "icon": "none",
            "icon_advanced_settings": false,
            "icon_height_desktop": 28,
            "icon_height": 27,
            "icon_margin_desktop": 0,
            "icon_margin": 0,
            "open_by_default": false
          }
        },
        "collapsible_tab_ThxWTb": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Order Tracking",
            "content": "<p>All standard customer orders are shipped with tracking.</p><p>Once your order has been dispatched, we will send a shipping confirmation email containing your tracking information.</p><p>Please allow some time after receiving your shipping confirmation for tracking information to become available or update in the carrier’s system.</p><p>Complimentary replacements may occasionally be sent using an alternative delivery service and may not include tracking. Where this applies, we will provide the available delivery information when your replacement is arranged.<br/><br/></p>",
            "page": "",
            "icon": "none",
            "icon_advanced_settings": false,
            "icon_height_desktop": 28,
            "icon_height": 27,
            "icon_margin_desktop": 0,
            "icon_margin": 0,
            "open_by_default": false
          }
        },
        "collapsible_tab_Re3KXP": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Delivery Estimates and Delays",
            "content": "<p>We work with our delivery partners to get your order to you within the estimated delivery timeframe.</p><p>However, delivery estimates are not guaranteed and may be affected by circumstances such as:</p><ul><li>carrier delays;</li><li>severe weather;</li><li>public holidays;</li><li>peak shopping periods;</li><li>customs or border processing for New Zealand orders; or other events outside our reasonable control.</li></ul><p>If your order has not arrived by the estimated delivery date shown in your tracking information, please check the tracking status first.</p><p>If there has been no recent tracking update or you are concerned about your delivery, contact us at <strong>service@sofneu.com.au</strong> and we will help investigate your order.</p><p>Nothing in this section limits any rights you may have under applicable consumer law.</p>",
            "page": "",
            "icon": "none",
            "icon_advanced_settings": false,
            "icon_height_desktop": 28,
            "icon_height": 27,
            "icon_margin_desktop": 0,
            "icon_margin": 0,
            "open_by_default": false
          }
        },
        "collapsible_tab_BDq6cJ": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Incorrect or Incomplete Shipping Addresses",
            "content": "<p>Please ensure that your shipping address is complete and accurate before placing your order.</p><p>If you need to change your address, contact us at <strong>service@sofneu.com.au</strong> as soon as possible.</p><p><strong>Before dispatch:</strong><br/><br/>If your order has not yet been dispatched, we will make reasonable efforts to update the address at no additional cost to you.</p><p><strong>After dispatch:</strong><br/><br/>Once an order has been dispatched, we cannot guarantee that the delivery address can be changed. We may attempt to arrange a redirect, recall or return with the carrier where available.</p><p>If an address change requested after dispatch results in additional costs, including <strong>carrier interception or redirection fees, return shipping fees, redelivery fees, or other reasonable logistics costs</strong>, these costs will be the customer’s responsibility.</p><p>Where an order cannot be recovered or is lost as a direct result of an incorrect address provided by the customer or an address change requested after dispatch, the customer may also be responsible for the resulting product loss, to the extent permitted by applicable law.</p><p>Nothing in this section limits your rights under applicable consumer law.</p>",
            "page": "",
            "icon": "none",
            "icon_advanced_settings": false,
            "icon_height_desktop": 28,
            "icon_height": 27,
            "icon_margin_desktop": 0,
            "icon_margin": 0,
            "open_by_default": false
          }
        },
        "collapsible_tab_paFEXD": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Lost Packages",
            "content": "<p>If you believe your package has been lost in transit, please contact us at <strong>service@sofneu.com.au</strong> with your order number.</p><p>We may first investigate the delivery with the relevant carrier.</p><p>If the package is confirmed as lost, we will work with you to provide an appropriate resolution in accordance with applicable consumer law.<br/><br/></p>",
            "page": "",
            "icon": "none",
            "icon_advanced_settings": false,
            "icon_height_desktop": 28,
            "icon_height": 27,
            "icon_margin_desktop": 0,
            "icon_margin": 0,
            "open_by_default": false
          }
        },
        "collapsible_tab_wWeFhm": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Packages Marked as Delivered or Awaiting Collection",
            "content": "<p>Please monitor your tracking information after your order has been dispatched, as the carrier may provide important delivery updates.</p><p>If delivery cannot be completed, your package may be taken to a nearby <strong>Post Office, collection point or other designated location</strong> for collection. Please follow the instructions provided by the carrier and collect your package within the specified timeframe.</p><p>If your tracking shows that your package has been delivered but you cannot locate it, please first:</p><ul><li>check the delivery location and any safe-drop areas;</li><li>check with household members, neighbours, reception or building management where applicable; and</li><li>review the latest tracking information to see whether the package is awaiting collection.</li></ul><p>If you still cannot locate your package, please contact us at <strong>service@sofneu.com.au</strong> and we will assist you with the next steps.</p><p>If a package is returned to us because it was not collected within the carrier’s required timeframe, additional shipping charges may apply if you request redelivery.<br/><br/></p>",
            "page": "",
            "icon": "none",
            "icon_advanced_settings": false,
            "icon_height_desktop": 28,
            "icon_height": 27,
            "icon_margin_desktop": 0,
            "icon_margin": 0,
            "open_by_default": false
          }
        },
        "collapsible_tab_DCpf4K": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Damaged Packages",
            "content": "<p>If your package arrives visibly damaged, please contact us as soon as reasonably possible.</p><p>Please provide:</p><ul><li>your order number;</li><li>a description of the issue; and photographs of the damaged packaging and affected products where reasonably possible.</li></ul><p>This will help us assess the issue and, where necessary, raise an enquiry with the delivery provider.</p><p>Your rights in relation to faulty or damaged products under applicable consumer law are not affected by this process.</p>",
            "page": "",
            "icon": "none",
            "icon_advanced_settings": false,
            "icon_height_desktop": 28,
            "icon_height": 27,
            "icon_margin_desktop": 0,
            "icon_margin": 0,
            "open_by_default": false
          }
        },
        "collapsible_tab_xz6daQ": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Returned to Sender",
            "content": "<p>A package may be returned to us if it cannot be delivered, including where the address is incorrect or incomplete, or the package is not collected within the carrier’s required timeframe.</p><p>If a package is returned because it was <strong>not collected within the required timeframe</strong>, the customer will be responsible for any <strong>return shipping costs and redelivery costs</strong> incurred.</p><p>If your package is returned to us, please contact <strong>service@sofneu.com.au</strong> and we will assist you with the available redelivery options.</p><p>Nothing in this section limits your rights under applicable consumer law.</p>",
            "page": "",
            "icon": "none",
            "icon_advanced_settings": false,
            "icon_height_desktop": 28,
            "icon_height": 27,
            "icon_margin_desktop": 0,
            "icon_margin": 0,
            "open_by_default": false
          }
        }
      },
