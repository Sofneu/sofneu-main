            "icon_margin": 0,
            "open_by_default": false
          }
        },
        "collapsible_tab_xE69d4": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Return Conditions",
            "content": "<p>For hygiene reasons, products must meet the following conditions for change-of-mind returns or exchanges:</p><ul><li><strong>Tights & Hosiery:</strong> unworn, unwashed, undamaged and in original packaging. Tried-on tights cannot be returned or exchanged.</li><li><strong>Adhesive Bras & Nipple Covers:</strong> unused, with protective film or hygiene protection intact.</li><li><strong>Sleepwear:</strong> may be tried on for fit, but must be unwashed, unworn beyond fitting, undamaged and have original tags attached.</li></ul><p>These conditions do not limit your rights in relation to faulty products under Australian Consumer Law.</p>",
            "page": "",
            "icon": "none",
            "icon_advanced_settings": false,
            "icon_height_desktop": 28,
            "icon_height": 27,
            "icon_margin_desktop": 0,
            "icon_margin": 0,
            "open_by_default": false
          }
        },
        "collapsible_tab_nr8AVz": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Faulty, Incorrect or Missing Items",
            "content": "<p>If your product is faulty, or we have sent you an incorrect item or missed an item from your order, please contact us with your <strong>order number and photos where applicable</strong>.</p><p>Where the issue is our responsibility, <strong>Sofneu will cover the applicable return and replacement shipping costs</strong>.</p><p>Faulty products will be handled in accordance with Australian Consumer Law. A remedy for a genuinely faulty product does not use your one-time 30-Day Guarantee.</p>",
