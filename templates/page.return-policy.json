        "collapsible_tab_VNm3HA": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Refunds",
            "content": "<p>Approved refunds are returned to your <strong>original payment method</strong>.</p><p>For change-of-mind returns:</p><ul><li>refunds are based on the amount actually paid for the returned products;</li><li>original shipping charges are non-refundable; and</li><li>return shipping is paid by the customer.</li></ul><p>We generally process refunds within <strong>5–10 business days</strong> after receiving and inspecting your return. Your bank or payment provider may take additional time to show the refund in your account.</p>",
