        "collapsible_tab_P4QAJi": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Returns & Exchanges",
            "content": "<p>Changed your mind or ordered the wrong size, colour or product? </p><p>You can request a <strong>return or exchange within 30 days of delivery</strong>.</p><p><strong>Returns</strong></p><ul><li>You pay the return shipping cost.</li><li>We’ll refund the amount paid for eligible returned products.</li><li>Original shipping charges are non-refundable.</li></ul><p><strong>Exchanges</strong></p><ul><li>You pay the shipping costs both ways.</li><li>Any difference in product price will be charged or refunded accordingly.</li><li>Exchanges are subject to availability.</li></ul>",
            "page": "",
            "icon": "none",
            "icon_advanced_settings": false,
            "icon_height_desktop": 28,
