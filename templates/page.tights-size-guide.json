      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% comment %}\n  Sofneu tights image guides\n  Responsive layout: desktop two columns; mobile stacked layout.\n{% endcomment %}\n\n<style>\n  .sofneu-tights-visuals,\n  .sofneu-tights-visuals * { box-sizing: border-box; }\n\n  .sofneu-tights-visuals {\n    --stv-ink: #342d28;\n    --stv-muted: #7d736b;\n    --stv-accent: #8b7355;\n    --stv-line: #eadfd6;\n    width: 100%;\n    max-width: 1100px;\n    margin: 0 auto;\n    padding-right: 20px;\n    padding-left: 20px;\n    color: var(--stv-ink);\n    font-family: inherit;\n  }\n\n  .sofneu-tights-visuals .stv-layout {\n    display: grid;\n    grid-template-columns: minmax(260px, 34%) minmax(0, 66%);\n    gap: 32px;\n    align-items: start;\n  }\n\n  .sofneu-tights-visuals .stv-section + .stv-section {\n    margin-top: 0;\n    padding: 0 0 0 32px;\n    border-top: 0;\n    border-left: 1px solid var(--stv-line);\n  }\n\n  .sofneu-tights-visuals .stv-title {\n    margin: 0 0 18px;\n    color: #2b2b2b;\n    text-align: center;\n  }\n\n  .sofneu-tights-visuals .stv-measure-image {\n    display: block;\n    width: auto;\n    max-width: 100%;\n    height: min(600px, 56vw);\n    margin: 0 auto;\n    object-fit: contain;\n  }\n\n  .sofneu-tights-visuals .stv-step-scroll {\n    overflow-x: auto;\n    padding: 2px 2px 10px;\n    scrollbar-width: thin;\n    scrollbar-color: #c8b9aa transparent;\n    -webkit-overflow-scrolling: touch;\n    overscroll-behavior-inline: contain;\n  }\n\n  .sofneu-tights-visuals .stv-steps {\n    display: grid;\n    grid-template-columns: repeat(6, minmax(0, 1fr));\n    gap: 10px;\n    min-width: 0;\n  }\n\n  .sofneu-tights-visuals .stv-step {\n    position: relative;\n    overflow: hidden;\n    min-width: 0;\n    border: 1px solid var(--stv-line);\n    border-radius: 12px;\n    background: #fff;\n    grid-column: span 2;\n  }\n\n  .sofneu-tights-visuals .stv-step:nth-child(4) { grid-column: 2 / span 2; }\n  .sofneu-tights-visuals .stv-step:nth-child(5) { grid-column: 4 / span 2; }\n\n  .sofneu-tights-visuals .stv-step img {\n    display: block;\n    width: 100%;\n    height: auto;\n    aspect-ratio: 4 / 5;\n    object-fit: contain;\n    background: #fff;\n  }\n\n  .sofneu-tights-visuals .stv-step-number {\n    position: absolute;\n    top: 8px;\n    left: 8px;\n    z-index: 1;\n    display: grid;\n    width: 27px;\n    height: 27px;\n    place-items: center;\n    border-radius: 50%;\n    background: var(--stv-accent);\n    color: #fff;\n    font-size: 13px;\n    font-weight: 700;\n    line-height: 1;\n  }\n\n  .sofneu-tights-visuals .stv-step-copy {\n    min-height: 58px;\n    margin: 0;\n    padding: 10px 9px 12px;\n    border-top: 1px solid var(--stv-line);\n    color: var(--stv-ink);\n    font-size: 12px;\n    line-height: 1.35;\n    text-align: center;\n  }\n\n  .sofneu-tights-visuals .stv-swipe {\n    display: none;\n    margin: 6px 0 0;\n    color: var(--stv-muted);\n    font-size: 11px;\n    text-align: right;\n  }\n\n  @media (max-width: 749px) {\n    .sofneu-tights-visuals {\n      padding-right: 14px;\n      padding-left: 14px;\n    }\n\n    .sofneu-tights-visuals .stv-layout { display: block; }\n\n    .sofneu-tights-visuals .stv-section + .stv-section {\n      margin-top: 28px;\n      padding-top: 26px;\n      padding-left: 0;\n      border-top: 1px solid var(--stv-line);\n      border-left: 0;\n    }\n\n    .sofneu-tights-visuals .stv-title {\n      margin-bottom: 13px;\nfont-size: 18px;\n    }\n\n    .sofneu-tights-visuals .stv-measure-image {\n      width: auto;\n      max-width: min(100%, 330px);\n      height: min(430px, 115vw);\n    }\n\n    .sofneu-tights-visuals .stv-step-scroll {\n      overflow: visible;\n      padding: 0;\n    }\n\n    .sofneu-tights-visuals .stv-steps {\n      display: grid;\n      grid-template-columns: repeat(6, minmax(0, 1fr));\n      gap: 8px;\n      min-width: 0;\n    }\n\n    .sofneu-tights-visuals .stv-step {\n      grid-column: span 2;\n      border-radius: 8px;\n    }\n\n    .sofneu-tights-visuals .stv-step-number {\n      top: 5px;\n      left: 5px;\n      width: 22px;\n      height: 22px;\n      font-size: 11px;\n    }\n\n    .sofneu-tights-visuals .stv-step-copy {\n      min-height: 56px;\n      padding: 7px 4px 8px;\n      font-size: 10px;\n      line-height: 1.25;\n    }\n\n    .sofneu-tights-visuals .stv-step:nth-child(4) {\n      grid-column: 2 / span 2;\n    }\n\n    .sofneu-tights-visuals .stv-step:nth-child(5) {\n      grid-column: 4 / span 2;\n    }\n\n    .sofneu-tights-visuals .stv-swipe {\n      display: none;\n    }\n  }\n</style>\n\n<section class=\"sofneu-tights-visuals\" aria-label=\"Tights measuring and dressing guides\">\n  <div class=\"stv-layout\">\n  <div class=\"stv-section\">\n    <h2 class=\"stv-title h2\">How To Measure</h2>\n    <img\n      class=\"stv-measure-image\"\n      src=\"https://cdn.shopify.com/s/files/1/0639/7716/0843/files/body_measure.png?v=1788830559E\"\n      alt=\"How to measure waist, hip, thigh and leg length for tights\"\n      loading=\"lazy\"\n      width=\"1200\"\n      height=\"900\"\n    >\n  </div>\n\n  <div class=\"stv-section\">\n    <h2 class=\"stv-title h2\">How To Put On Your Tights</h2>\n\n    <div class=\"stv-step-scroll\" tabindex=\"0\" aria-label=\"Five steps for putting on tights. Swipe horizontally on mobile.\">\n      <div class=\"stv-steps\">\n        <div class=\"stv-step\">\n          <span class=\"stv-step-number\" aria-hidden=\"true\">1</span>\n          <img src=\"https://cdn.shopify.com/s/files/1/0639/7716/0843/files/sofneu-tights-step-2.webp?v=1788830558\" alt=\"Step 1: Gather your tights and find the waistband\" loading=\"lazy\" width=\"800\" height=\"1000\">\n          <p class=\"stv-step-copy\">Gather your tights and find the waistband.</p>\n        </div>\n        <div class=\"stv-step\">\n          <span class=\"stv-step-number\" aria-hidden=\"true\">2</span>\n          <img src=\"https://cdn.shopify.com/s/files/1/0639/7716/0843/files/sofneu-tights-step-3.webp?v=1788830558\" alt=\"Step 2: Position your toes and heel\" loading=\"lazy\" width=\"800\" height=\"1000\">\n          <p class=\"stv-step-copy\">Position your toes and heel.</p>\n        </div>\n        <div class=\"stv-step\">\n          <span class=\"stv-step-number\" aria-hidden=\"true\">3</span>\n          <img src=\"https://cdn.shopify.com/s/files/1/0639/7716/0843/files/sofneu-tights-step-4.webp?v=1788830558\" alt=\"Step 3: Gently pull the tights up to your knees\" loading=\"lazy\" width=\"800\" height=\"1000\">\n          <p class=\"stv-step-copy\">Gently pull up to your knees.</p>\n        </div>\n        <div class=\"stv-step\">\n          <span class=\"stv-step-number\" aria-hidden=\"true\">4</span>\n          <img src=\"https://cdn.shopify.com/s/files/1/0639/7716/0843/files/sofneu-tights-step-5.webp?v=1788830558\" alt=\"Step 4: Adjust evenly and smooth the fabric\" loading=\"lazy\" width=\"800\" height=\"1000\">\n          <p class=\"stv-step-copy\">Adjust evenly and smooth the fabric.</p>\n        </div>\n        <div class=\"stv-step\">\n          <span class=\"stv-step-number\" aria-hidden=\"true\">5</span>\n          <img src=\"https://cdn.shopify.com/s/files/1/0639/7716/0843/files/sofneu-tights-step-1.webp?v=1788830558\" alt=\"Step 5: Check the tights for a comfortable even fit\" loading=\"lazy\" width=\"800\" height=\"1000\">\n          <p class=\"stv-step-copy\">Check for a comfortable fit.</p>\n        </div>\n      </div>\n    </div>\n\n    <p class=\"stv-swipe\" aria-hidden=\"true\">Swipe to see all steps →</p>\n  </div>\n  </div>\n</section>"
      }
    },
