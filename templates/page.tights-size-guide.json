    "custom_liquid_gzEaDg": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% comment %}\n  Sofneu single-size tights chart — standalone Custom Liquid.\n  Paste this entire file into one Shopify Custom liquid block.\n{% endcomment %}\n\n<style>\n  .sofneu-tights-single,.sofneu-tights-single *{box-sizing:border-box}\n  .sofneu-tights-single{--ts-ink:#2f2b28;--ts-muted:#7e756e;--ts-line:#e9e1da;--ts-accent:#8b7355;--ts-soft:#f6f1ec;width:100%;max-width:1100px;margin:0 auto;padding-right:10px;padding-left:10px;color:var(--ts-ink);font-family:inherit;line-height:1.45}\n  .sofneu-tights-single .ts-head{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:12px}\n  .sofneu-tights-single .ts-intro{max-width:500px;margin:0;color:var(--ts-muted);font-size:12px}\n  .sofneu-tights-single .ts-controls{display:flex;align-items:center;gap:14px;flex-shrink:0}\n  .sofneu-tights-single .ts-control-row{display:flex;align-items:center;gap:6px}\n  .sofneu-tights-single .ts-control-row>span{color:var(--ts-muted);font-size:9px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}\n  .sofneu-tights-single .ts-toggle{display:flex;width:156px;overflow:hidden;border:1px solid #dcd2ca;border-radius:7px;background:#fff}\n  .sofneu-tights-single .ts-toggle button{flex:1;min-height:32px;padding:5px 9px;border:0;border-right:1px solid #dcd2ca;background:#fff;color:#6f6862;font:inherit;font-size:10px;font-weight:700;cursor:pointer;touch-action:manipulation}\n  .sofneu-tights-single .ts-toggle button:last-child{border-right:0}\n  .sofneu-tights-single .ts-toggle button.is-active{background:var(--ts-accent);color:#fff}\n  .sofneu-tights-single button:focus-visible{outline:3px solid rgba(139,115,85,.35);outline-offset:2px}\n  .sofneu-tights-single .ts-scroll{overflow-x:auto;border-top:1px solid var(--ts-line);-webkit-overflow-scrolling:touch;overscroll-behavior-inline:contain}\n  .sofneu-tights-single table{width:100%;min-width:900px;margin:0;border:0!important;border-collapse:collapse;table-layout:fixed;box-shadow:none!important;font-size:12px}\n  .sofneu-tights-single th,.sofneu-tights-single td{padding:11px 7px;border:0!important;border-bottom:1px solid var(--ts-line)!important;outline:0!important;box-shadow:none!important;text-align:center;white-space:nowrap}\n  .sofneu-tights-single thead th{background:var(--ts-accent);color:#fff;font-weight:700}\n  .sofneu-tights-single thead th:first-child{width:108px}\n  .sofneu-tights-single tbody th{position:sticky;left:0;z-index:2;background:#fff;color:#5c4a3a;text-align:left}\n  .sofneu-tights-single tbody tr:nth-child(-n+4) td{background:rgba(246,241,236,.72)}\n  .sofneu-tights-single th small{display:block;margin-top:2px;font-size:9px;font-weight:500;opacity:.82}\n  .sofneu-tights-single tbody th small{margin-top:0;color:var(--ts-muted);font-size:8px}\n  .sofneu-tights-single .ts-region-name,.sofneu-tights-single .ts-region-code{display:inline}\n  .sofneu-tights-single .ts-region-name::after{content:' '}\n  .sofneu-tights-single .ts-swipe{display:none;margin:7px 0 0;color:var(--ts-muted);font-size:10px;text-align:right}\n\n  @media(max-width:749px){\n    .sofneu-tights-single .ts-head{display:block;margin-bottom:10px}\n    .sofneu-tights-single .ts-intro{font-size:10px;line-height:1.4}\n    .sofneu-tights-single .ts-controls{display:grid;gap:5px;width:100%;margin-top:9px}\n    .sofneu-tights-single .ts-control-row{display:grid;grid-template-columns:42px 1fr;gap:5px;align-items:center}\n    .sofneu-tights-single .ts-toggle{width:100%}\n    .sofneu-tights-single .ts-toggle button{min-height:32px;padding:4px 8px;font-size:10px}\n    .sofneu-tights-single table{min-width:720px;font-size:9px}\n    .sofneu-tights-single th,.sofneu-tights-single td{padding:8px 4px}\n    .sofneu-tights-single thead th:first-child{width:76px}\n    .sofneu-tights-single thead th small{font-size:7px;line-height:1.15}\n    .sofneu-tights-single tbody th{font-size:9px;line-height:1.2}\n    .sofneu-tights-single tbody th small{font-size:7px}\n    .sofneu-tights-single .ts-region-name,.sofneu-tights-single .ts-region-code{display:block}\n    .sofneu-tights-single .ts-region-name::after{content:''}\n    .sofneu-tights-single .ts-swipe{display:block}\n  }\n</style>\n\n<section class=\"sofneu-tights-single\" data-region=\"au\" data-unit=\"metric\" aria-label=\"Sofneu single-size tights chart\">\n  <div class=\"ts-head\">\n    <p class=\"ts-intro\">Use your body measurements to choose your Sofneu size. Regional clothing sizes are approximate equivalents.</p>\n\n    <div class=\"ts-controls\">\n      <div class=\"ts-control-row\">\n        <span>Region</span>\n        <div class=\"ts-toggle\" aria-label=\"Choose region\">\n          <button type=\"button\" class=\"ts-region-button is-active\" data-region=\"au\" aria-pressed=\"true\">AU / NZ</button>\n          <button type=\"button\" class=\"ts-region-button\" data-region=\"us\" aria-pressed=\"false\">US</button>\n        </div>\n      </div>\n\n      <div class=\"ts-control-row\">\n        <span>Units</span>\n        <div class=\"ts-toggle\" aria-label=\"Choose measurement units\">\n          <button type=\"button\" class=\"ts-unit-button is-active\" data-unit=\"metric\" aria-pressed=\"true\">cm / kg</button>\n          <button type=\"button\" class=\"ts-unit-button\" data-unit=\"imperial\" aria-pressed=\"false\">in / lb</button>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"ts-scroll\" tabindex=\"0\" aria-label=\"Tights size chart. Swipe horizontally to view all sizes on mobile.\">\n    <table>\n      <thead></thead>\n      <tbody></tbody>\n    </table>\n  </div>\n\n  <p class=\"ts-swipe\" aria-hidden=\"true\">Swipe to view all sizes →</p>\n</section>\n\n<script>\n(function(){\n  'use strict';\n\n  var DATA=[\n    {size:'S',au:'4–8',us:'0–4',metric:['150–165','40–55','60–74','82–94','44–52','100–110'],imperial:['4′11″–5′5″','88–121','23.6–29.1','32.3–37.0','17.3–20.5','39.4–43.3']},\n    {size:'M',au:'8–12',us:'4–8',metric:['155–170','50–65','65–79','88–100','48–56','105–116'],imperial:['5′1″–5′7″','110–143','25.6–31.1','34.6–39.4','18.9–22.0','41.3–45.7']},\n    {size:'L',au:'12–16',us:'8–12',metric:['160–175','60–75','70–84','94–106','52–60','111–123'],imperial:['5′3″–5′9″','132–165','27.6–33.1','37.0–41.7','20.5–23.6','43.7–48.4']},\n    {size:'XL',au:'16–20',us:'12–16',metric:['165–180','70–85','76–90','100–112','56–64','117–128'],imperial:['5′5″–5′11″','154–187','29.9–35.4','39.4–44.1','22.0–25.2','46.1–50.4']},\n    {size:'2XL',au:'20–22',us:'16–18',metric:['168–183','80–98','82–97','106–118','60–69','123–134'],imperial:['5′6″–6′0″','176–216','32.3–38.2','41.7–46.5','23.6–27.2','48.4–52.8']},\n    {size:'3XL',au:'22–24',us:'18–20',metric:['168–185','92–113','90–106','114–129','65–75','123–134'],imperial:['5′6″–6′1″','203–249','35.4–41.7','44.9–50.8','25.6–29.5','48.4–52.8']},\n    {size:'4XL',au:'24–26',us:'20–22',metric:['168–185','105–128','100–116','124–139','70–80','123–134'],imperial:['5′6″–6′1″','231–282','39.4–45.7','48.8–54.7','27.6–31.5','48.4–52.8']},\n    {size:'5XL',au:'26–28',us:'22–24',metric:['168–185','120–143','110–126','134–149','76–86','123–134'],imperial:['5′6″–6′1″','265–315','43.3–49.6','52.8–58.7','29.9–33.9','48.4–52.8']},\n    {size:'6XL',au:'28–32',us:'24–28',metric:['168–185','135–158','120–136','144–161','82–92','123–134'],imperial:['5′6″–6′1″','298–348','47.2–53.5','56.7–63.4','32.3–36.2','48.4–52.8']}\n  ];\n  var ROWS=['Height','Weight','Waist','Hip','Thigh','Leg Length'];\n\n  function render(root){\n    var region=root.getAttribute('data-region')||'au';\n    var unit=root.getAttribute('data-unit')||'metric';\n    var regionLabel=region==='au'?'AU / NZ':'US';\n\n    root.querySelectorAll('.ts-region-button').forEach(function(button){\n      var active=button.getAttribute('data-region')===region;\n      button.classList.toggle('is-active',active);\n      button.setAttribute('aria-pressed',active?'true':'false');\n    });\n    root.querySelectorAll('.ts-unit-button').forEach(function(button){\n      var active=button.getAttribute('data-unit')===unit;\n      button.classList.toggle('is-active',active);\n      button.setAttribute('aria-pressed',active?'true':'false');\n    });\n\n    var rowUnits=unit==='metric'?['cm','kg','cm','cm','cm','cm']:['ft / in','lb','in','in','in','in'];\n\n    root.querySelector('thead').innerHTML='<tr><th>Measurement</th>'+DATA.map(function(item){\n      return '<th>'+item.size+'<small><span class=\"ts-region-name\">'+regionLabel+'</span><span class=\"ts-region-code\">'+item[region]+'</span></small></th>';\n    }).join('')+'</tr>';\n\n    root.querySelector('tbody').innerHTML=ROWS.map(function(row,rowIndex){\n      return '<tr><th>'+row+'<small>'+rowUnits[rowIndex]+'</small></th>'+DATA.map(function(item){\n        return '<td>'+item[unit][rowIndex]+'</td>';\n      }).join('')+'</tr>';\n    }).join('');\n  }\n\n  function init(root){\n    if(root.getAttribute('data-ts-ready')==='true')return;\n    root.setAttribute('data-ts-ready','true');\n    render(root);\n  }\n\n  document.querySelectorAll('.sofneu-tights-single').forEach(init);\n\n  if(window.__sofneuTightsSingleBound)return;\n  window.__sofneuTightsSingleBound=true;\n\n  document.addEventListener('click',function(event){\n    var button=event.target.closest('.sofneu-tights-single .ts-region-button,.sofneu-tights-single .ts-unit-button');\n    if(!button)return;\n    var root=button.closest('.sofneu-tights-single');\n    if(button.hasAttribute('data-region'))root.setAttribute('data-region',button.getAttribute('data-region'));\n    if(button.hasAttribute('data-unit'))root.setAttribute('data-unit',button.getAttribute('data-unit'));\n    render(root);\n  });\n\n  document.addEventListener('shopify:section:load',function(event){\n    event.target.querySelectorAll('.sofneu-tights-single').forEach(init);\n  });\n})();\n</script>"
