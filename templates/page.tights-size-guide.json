    "faq_tabs_trMwMV": {
      "type": "faq-tabs",
      "blocks": {
        "faq_cj6qAa": {
          "type": "faq",
          "settings": {
            "show_item": true,
            "category": "tab_1",
            "question": "Why do Sofneu tights come in combined sizes?",
            "answer": "<p>Sofneu tights are highly stretchable and designed to comfortably adapt to a range of body shapes. Combined sizing offers more flexibility, makes choosing a size easier and reduces the risk of selecting the wrong size.</p><p>If your measurements fall across two sizes, use your hip and waist measurements as the primary reference.</p>",
            "default_open": false
          }
        },
        "faq_H3jF4F": {
          "type": "faq",
          "settings": {
            "show_item": true,
            "category": "tab_1",
            "question": "How do I choose my Sofneu tights size?",
            "answer": "<p>Measure your natural waist, the fullest part of your hips and the fullest part of your upper thigh, then compare them with the size chart.</p><p>Waist and hip measurements are the most important. Height, weight and leg length should be used as additional references.</p>",
            "default_open": true
          }
        },
        "faq_zpiwNm": {
          "type": "faq",
          "settings": {
            "show_item": true,
            "category": "tab_1",
            "question": "What should I do if I am between two sizes?",
            "answer": "<p>If your measurements fall between two sizes, choose the larger size for more length and comfort.</p><p>If your waist and hips fit the smaller size and you prefer a closer, more supportive fit, you may choose the smaller size. If any key measurement exceeds the smaller size range, choose the larger size.</p>",
            "default_open": false
          }
        },
        "faq_ELJNcp": {
          "type": "faq",
          "settings": {
            "show_item": true,
            "category": "tab_1",
            "question": "Do different tights styles fit differently?",
            "answer": "<p>Yes. Stretch, waistband construction, compression level and fabric thickness can affect how each style feels and fits.</p><p>Always check the size chart shown on the individual product page. If that product has a style-specific recommendation, follow it instead of relying only on your usual clothing size.</p>",
            "default_open": false
          }
        },
        "faq_BNrQVU": {
          "type": "faq",
          "settings": {
            "show_item": true,
            "category": "tab_1",
            "question": "Where should high-waisted and mid-rise tights sit?",
            "answer": "<p>High-waisted tights are designed to sit at the natural waist, usually around or slightly above the belly button.</p><p>Mid-rise tights sit lower, generally below the belly button and above the hip bones. The exact position may vary slightly depending on torso length and body shape.</p>",
            "default_open": false
          }
        },
        "faq_h9QJJi": {
          "type": "faq",
          "settings": {
            "show_item": true,
            "category": "tab_1",
            "question": "Will the tights slip down or sag?",
            "answer": "<p>Correctly sized tights should sit comfortably with the gusset positioned close to the body and should not require frequent pulling up.</p><p>Slipping or sagging may indicate that the size is too large, the tights have not been pulled up evenly, or insufficient fabric has been distributed along the legs. If the waistband feels tight while the crotch sits too low, you may need a larger size or more leg length.</p>",
            "default_open": false
          }
        },
        "faq_CYjKWp": {
          "type": "faq",
          "settings": {
            "show_item": true,
            "category": "tab_1",
            "question": "How can I tell if my tights are too small?",
            "answer": "<p>Your tights may be too small if:</p><ul><li>The waistband digs in or leaves strong pressure marks.</li><li>The fabric feels excessively stretched or difficult to pull on.</li><li>The crotch cannot be comfortably pulled into position.</li><li>The toes feel tight or the fabric is under excessive tension.</li><li>The tights become noticeably more sheer than intended.</li></ul>",
            "default_open": false
          }
        },
        "faq_KcJnYx": {
          "type": "faq",
          "settings": {
            "show_item": true,
            "category": "tab_1",
            "question": "How can I tell if my tights are too large?",
            "answer": "<p>Your tights may be too large if:</p><ul><li>They bunch around the ankles or knees.</li><li>The waistband slips down repeatedly.</li><li>The crotch sags during wear.</li><li>You need to pull the waistband unusually high to position the gusset correctly.</li><li>The fabric looks loose or uneven on the legs.</li></ul>",
            "default_open": false
          }
        },
        "faq_Bdc9QK": {
          "type": "faq",
          "settings": {
            "show_item": true,
            "category": "tab_1",
            "question": "What size should I choose if I am tall, short, curvy or slim?",
            "answer": "<p>If you are tall or have longer legs, choose the larger size when you are between sizes to allow more vertical stretch.</p><p>If you are shorter, do not automatically size down—use your waist and hip measurements first. If you have fuller hips, thighs or tummy, follow the largest relevant body measurement. If you are slim with longer legs, prioritise leg length without choosing a size that will be too loose at the waist.</p>",
            "default_open": false
          }
        },
        "faq_QpxXCK": {
          "type": "faq",
          "settings": {
            "show_item": true,
            "category": "tab_1",
            "question": "Should I use my usual clothing size to choose tights?",
            "answer": "<p>Your usual AU/NZ or US clothing size is a helpful reference, but sizing can vary between brands.</p><p>For the most reliable fit, use your actual body measurements and treat regional clothing sizes as approximate equivalents. If your clothing size and measurements suggest different Sofneu sizes, follow your waist and hip measurements first.</p>",
            "default_open": false
          }
        }
      },
