{% liquid
  assign section_id = section.id | replace: '_', '' | downcase
%}

{% style %}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.section_background }};
    overflow-x: hidden;
  }

  .product-accordion-tabs-{{ section_id }} {
    width: 100%;
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  .product-accordion-tabs-{{ section_id }} * {
    box-sizing: border-box;
  }

  .product-accordion-tabs__inner-{{ section_id }} {
    width: 100%;
    max-width: {{ section.settings.section_max_width }}px;
    margin: 0 auto;
    padding: 0 {{ section.settings.side_padding_mobile }}px;
  }

  .product-accordion-tabs__title-{{ section_id }} {
    margin: 0 0 {{ section.settings.title_spacing }}px;
    color: {{ section.settings.title_color }};
    font-size: {{ section.settings.title_size_mobile }}px;
    line-height: 1.15;
    letter-spacing: {{ section.settings.title_letter_spacing | divided_by: 100.0 }}em;
    text-align: {{ section.settings.title_alignment }};
  }

  .product-accordion-tabs__accordion-{{ section_id }} {
    width: 100%;
    margin: 0 auto;
    padding: {{ section.settings.content_padding_mobile }}px;
    background: {{ section.settings.accordion_background }};
    border-radius: {{ section.settings.accordion_radius }}px;
  }

  .product-accordion-tabs__items-{{ section_id }} {
    width: 100%;
    margin: 0 auto;
  }

  {% if section.settings.accordion_width_mode == 'full' %}
    .product-accordion-tabs__accordion-{{ section_id }} {
      width: 100vw;
      max-width: 100vw;
      margin-left: calc(50% - 50vw);
      margin-right: calc(50% - 50vw);
      border-radius: 0;
    }

    .product-accordion-tabs__items-{{ section_id }} {
      max-width: {{ section.settings.section_max_width }}px;
    }
  {% elsif section.settings.accordion_width_mode == 'custom' %}
    .product-accordion-tabs__accordion-{{ section_id }} {
      position: relative;
      left: 50%;
      width: min({{ section.settings.accordion_max_width }}px, 100vw);
      max-width: 100vw;
      transform: translateX(-50%);
    }
  {% endif %}

  .product-accordion-tabs__item-{{ section_id }} {
    border-bottom: {{ section.settings.divider_thickness }}px solid {{ section.settings.divider_color }};
    padding: {{ section.settings.item_spacing }}px 0;
  }

  .product-accordion-tabs__item-{{ section_id }}:first-child {
    padding-top: 0;
  }

  .product-accordion-tabs__item-{{ section_id }}:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .product-accordion-tabs__trigger-{{ section_id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: 16px;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    text-align: left;
  }

  .product-accordion-tabs__trigger-{{ section_id }}:hover,
  .product-accordion-tabs__trigger-{{ section_id }}:focus,
  .product-accordion-tabs__trigger-{{ section_id }}:focus-visible {
    background: transparent;
    box-shadow: none;
    color: inherit;
    opacity: 1;
    outline: none;
    text-decoration: none;
  }

  .product-accordion-tabs__item-title-{{ section_id }} {
    min-width: 0;
    margin: 0;
    color: {{ section.settings.accordion_title_color }};
    font-size: {{ section.settings.accordion_title_size_mobile }}px;
    line-height: 1.25;
    letter-spacing: {{ section.settings.accordion_title_letter_spacing | divided_by: 100.0 }}em;
  }

  .product-accordion-tabs__trigger-{{ section_id }}:hover .product-accordion-tabs__item-title-{{ section_id }},
  .product-accordion-tabs__trigger-{{ section_id }}:focus .product-accordion-tabs__item-title-{{ section_id }} {
    color: {{ section.settings.accordion_title_color }};
    text-decoration: none;
  }

  .product-accordion-tabs__icon-{{ section_id }} {
    display: inline-flex;
    width: {{ section.settings.arrow_size }}px;
    height: {{ section.settings.arrow_size }}px;
    flex: 0 0 {{ section.settings.arrow_size }}px;
    color: {{ section.settings.arrow_color }};
    transition: transform 220ms ease;
  }

  .product-accordion-tabs__item-{{ section_id }}.is-open .product-accordion-tabs__icon-{{ section_id }} {
    transform: rotate(180deg);
  }

  .product-accordion-tabs__panel-{{ section_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 280ms ease;
  }

  .product-accordion-tabs__panel-inner-{{ section_id }} {
    padding-top: {{ section.settings.content_top_spacing }}px;
  }

  .product-accordion-tabs__content-{{ section_id }} {
    color: {{ section.settings.content_color }};
    font-size: {{ section.settings.content_size_mobile }}px;
    line-height: {{ section.settings.content_line_height | divided_by: 100.0 }};
    letter-spacing: {{ section.settings.content_letter_spacing | divided_by: 100.0 }}em;
  }

  .product-accordion-tabs__content-{{ section_id }} > *:first-child {
    margin-top: 0;
  }

  .product-accordion-tabs__content-{{ section_id }} > *:last-child {
    margin-bottom: 0;
  }

  .product-accordion-tabs__image-{{ section_id }} {
    display: block;
    width: 100%;
    height: auto;
    margin: 0 0 {{ section.settings.media_spacing }}px;
    border-radius: {{ section.settings.image_radius }}px;
  }

  .product-accordion-tabs__image--bottom-{{ section_id }} {
    margin: {{ section.settings.media_spacing }}px 0 0;
  }

  .product-accordion-tabs__button-{{ section_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: {{ section.settings.button_spacing }}px;
    padding: 10px 18px;
    border: 1px solid {{ section.settings.button_border_color }};
    border-radius: {{ section.settings.button_radius }}px;
    background: {{ section.settings.button_background }};
    color: {{ section.settings.button_color }};
    font-size: {{ section.settings.button_size }}px;
    line-height: 1;
    text-decoration: none;
  }

  .product-accordion-tabs__button-{{ section_id }}:hover,
  .product-accordion-tabs__button-{{ section_id }}:focus {
    background: {{ section.settings.button_background }};
    border-color: {{ section.settings.button_border_color }};
    color: {{ section.settings.button_color }};
    opacity: 1;
    text-decoration: none;
  }

  .product-accordion-tabs__custom-liquid-{{ section_id }} {
    margin-top: {{ section.settings.custom_liquid_spacing }}px;
  }

  @media screen and (min-width: 750px) {
    .product-accordion-tabs-{{ section_id }} {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }

    .product-accordion-tabs__inner-{{ section_id }} {
      padding: 0 {{ section.settings.side_padding_desktop }}px;
    }

    .product-accordion-tabs__title-{{ section_id }} {
      font-size: {{ section.settings.title_size_desktop }}px;
    }

    .product-accordion-tabs__accordion-{{ section_id }} {
      padding: {{ section.settings.content_padding_desktop }}px;
    }

    .product-accordion-tabs__item-title-{{ section_id }} {
      font-size: {{ section.settings.accordion_title_size_desktop }}px;
    }

    .product-accordion-tabs__content-{{ section_id }} {
      font-size: {{ section.settings.content_size_desktop }}px;
    }
  }
{% endstyle %}

<div
  class="product-accordion-tabs-{{ section_id }}"
  data-product-accordion-tabs
  data-allow-multiple="{{ section.settings.allow_multiple_open }}"
>
  <div class="product-accordion-tabs__inner-{{ section_id }}">
    {% if section.settings.title != blank %}
      <h2 class="product-accordion-tabs__title-{{ section_id }}">
        {{ section.settings.title }}
      </h2>
    {% endif %}

    <div class="product-accordion-tabs__accordion-{{ section_id }}">
      <div class="product-accordion-tabs__items-{{ section_id }}">
        {% for block in section.blocks %}
          {% if block.settings.show_item %}
            {% liquid
              assign panel_id = 'ProductAccordionPanel-' | append: section.id | append: '-' | append: block.id
              assign trigger_id = 'ProductAccordionTrigger-' | append: section.id | append: '-' | append: block.id
              assign image_class = 'product-accordion-tabs__image-' | append: section_id
              assign image_bottom_class = image_class | append: ' product-accordion-tabs__image--bottom-' | append: section_id
            %}

            <div
              class="product-accordion-tabs__item-{{ section_id }}{% if block.settings.default_open %} is-open{% endif %}"
              data-accordion-item
              {{ block.shopify_attributes }}
            >
              <button
                id="{{ trigger_id }}"
                class="product-accordion-tabs__trigger-{{ section_id }}"
                type="button"
                aria-expanded="{% if block.settings.default_open %}true{% else %}false{% endif %}"
                aria-controls="{{ panel_id }}"
                data-accordion-trigger
              >
                <span class="product-accordion-tabs__item-title-{{ section_id }}">
                  {{ block.settings.title }}
                </span>
                <span class="product-accordion-tabs__icon-{{ section_id }}" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </button>

              <div
                id="{{ panel_id }}"
                class="product-accordion-tabs__panel-{{ section_id }}"
                role="region"
                aria-labelledby="{{ trigger_id }}"
                data-accordion-panel
              >
                <div class="product-accordion-tabs__panel-inner-{{ section_id }}">
                  {% if block.settings.image != blank and block.settings.image_position == 'top' %}
                    {{ block.settings.image | image_url: width: 1400 | image_tag: class: image_class, loading: 'lazy' }}
                  {% endif %}

                  {% if block.settings.content != blank %}
                    <div class="product-accordion-tabs__content-{{ section_id }}">
                      {{ block.settings.content }}
                    </div>
                  {% endif %}

                  {% if block.settings.image != blank and block.settings.image_position == 'bottom' %}
                    {{ block.settings.image | image_url: width: 1400 | image_tag: class: image_bottom_class, loading: 'lazy' }}
                  {% endif %}

                  {% if block.settings.button_text != blank and block.settings.button_link != blank %}
                    <a class="product-accordion-tabs__button-{{ section_id }}" href="{{ block.settings.button_link }}">
                      {{ block.settings.button_text }}
                    </a>
                  {% endif %}

                  {% if block.settings.custom_liquid != blank %}
                    <div class="product-accordion-tabs__custom-liquid-{{ section_id }}">
                      {{ block.settings.custom_liquid }}
                    </div>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<script>
  (() => {
    const initProductAccordionTabs = (root = document) => {
      root.querySelectorAll('[data-product-accordion-tabs]').forEach((accordion) => {
        if (accordion.dataset.initialized === 'true') return;
        accordion.dataset.initialized = 'true';

        const allowMultiple = accordion.dataset.allowMultiple === 'true';
        const items = Array.from(accordion.querySelectorAll('[data-accordion-item]'));

        const setItem = (item, open) => {
          const trigger = item.querySelector('[data-accordion-trigger]');
          const panel = item.querySelector('[data-accordion-panel]');

          item.classList.toggle('is-open', open);
          trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
          panel.style.maxHeight = open ? `${panel.scrollHeight}px` : '0px';
        };

        if (!allowMultiple) {
          let foundOpen = false;
          items.forEach((item) => {
            const shouldOpen = item.classList.contains('is-open') && !foundOpen;
            foundOpen = foundOpen || shouldOpen;
            setItem(item, shouldOpen);
          });
        } else {
          items.forEach((item) => setItem(item, item.classList.contains('is-open')));
        }

        items.forEach((item) => {
          const trigger = item.querySelector('[data-accordion-trigger]');

          trigger.addEventListener('click', () => {
            const willOpen = !item.classList.contains('is-open');

            if (!allowMultiple) {
              items.forEach((otherItem) => {
                if (otherItem !== item) setItem(otherItem, false);
              });
            }

            setItem(item, willOpen);
          });
        });

        window.addEventListener('resize', () => {
          items.forEach((item) => {
            if (item.classList.contains('is-open')) setItem(item, true);
          });
        });
      });
    };

    document.addEventListener('DOMContentLoaded', () => initProductAccordionTabs());
    document.addEventListener('shopify:section:load', (event) => initProductAccordionTabs(event.target));
    initProductAccordionTabs();
  })();
</script>

