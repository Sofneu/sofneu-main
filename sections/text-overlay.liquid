{% liquid
  assign section_id = section.id | replace: '_', '' | downcase
  assign desktop_image = section.settings.desktop_image | default: section.settings.mobile_image
  assign mobile_image = section.settings.mobile_image | default: section.settings.desktop_image
  assign image_class = 'text-overlay__image-' | append: section_id
  assign placeholder_class = 'text-overlay__placeholder-' | append: section_id
%}

{% style %}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.section_background }};
    overflow-x: hidden;
  }

  .text-overlay-{{ section_id }} {
    width: 100%;
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  .text-overlay-{{ section_id }} * {
    box-sizing: border-box;
  }

  .text-overlay__inner-{{ section_id }} {
    width: 100%;
    max-width: {% if section.settings.width_style == 'contained' %}{{ section.settings.mobile_max_width }}px{% else %}none{% endif %};
    margin: 0 auto;
    padding: 0 {{ section.settings.side_padding_mobile }}px;
  }

  .text-overlay__layout-{{ section_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.mobile_content_gap }}px;
    width: 100%;
  }

  .text-overlay__media-{{ section_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: {{ section.settings.image_radius }}px;
    background: #f6f6f6;
  }

  {% if section.settings.image_size_mode == 'custom' %}
    .text-overlay__media-{{ section_id }} {
      height: {{ section.settings.mobile_image_height }}px;
    }
  {% endif %}

  .text-overlay__image-{{ section_id }},
  .text-overlay__placeholder-{{ section_id }} {
    display: block;
    width: 100%;
    height: {% if section.settings.image_size_mode == 'custom' %}100%{% else %}auto{% endif %};
    object-fit: {{ section.settings.image_fit }};
    object-position: center;
  }

  .text-overlay__placeholder-{{ section_id }} {
    min-height: 280px;
  }

  .text-overlay__content-{{ section_id }} {
    display: flex;
    flex-direction: column;
    align-items: {{ section.settings.content_alignment }};
    gap: {{ section.settings.content_gap }}px;
    width: 100%;
    max-width: {{ section.settings.mobile_content_max_width }}px;
    text-align: {{ section.settings.content_text_align }};
  }

  {% if section.settings.mobile_content_layout == 'overlay' %}
    .text-overlay__content-{{ section_id }} {
      position: absolute;
      left: {{ section.settings.mobile_overlay_x }}%;
      top: {{ section.settings.mobile_overlay_y }}%;
      z-index: 2;
      width: calc(100% - {{ section.settings.mobile_overlay_safe_padding | times: 2 }}px);
      transform: translate(-{{ section.settings.mobile_overlay_x }}%, -{{ section.settings.mobile_overlay_y }}%);
    }

    .text-overlay__content--desktop-{{ section_id }} {
      display: none;
    }
  {% else %}
    .text-overlay__content--mobile-{{ section_id }} {
      display: none;
    }
  {% endif %}

  .text-overlay__heading-{{ section_id }} {
    color: var(--text-overlay-heading-color);
    font-size: var(--text-overlay-heading-size-mobile);
    line-height: 1.15;
  }

  .text-overlay__heading-{{ section_id }} > * {
    margin-top: 0;
    margin-bottom: 0;
  }

  .text-overlay__text-{{ section_id }} {
    color: var(--text-overlay-text-color);
    font-size: var(--text-overlay-text-size-mobile);
    line-height: 1.45;
  }

  .text-overlay__text-{{ section_id }} > *:first-child {
    margin-top: 0;
  }

  .text-overlay__text-{{ section_id }} > *:last-child {
    margin-bottom: 0;
  }

  .text-overlay__icon-item-{{ section_id }} {
    display: flex;
    align-items: center;
    gap: {{ section.settings.icon_text_gap }}px;
    width: 100%;
    max-width: var(--text-overlay-icon-max-width);
  }

  .text-overlay__icon-{{ section_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--text-overlay-icon-size-mobile);
    height: var(--text-overlay-icon-size-mobile);
    flex: 0 0 var(--text-overlay-icon-size-mobile);
  }

  .text-overlay__icon-{{ section_id }} img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .text-overlay__icon-fallback-{{ section_id }} {
    width: 100%;
    height: 100%;
    border-radius: 999px;
    background: currentColor;
  }

  .text-overlay__icon-copy-{{ section_id }} {
    min-width: 0;
  }

  .text-overlay__icon-title-{{ section_id }} {
    margin: 0;
    color: var(--text-overlay-icon-title-color);
    font-size: var(--text-overlay-icon-title-size-mobile);
    line-height: 1.4;
    font-weight: 400;
  }

  .text-overlay__button-{{ section_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: {{ section.settings.button_height }}px;
    padding: 0 {{ section.settings.button_padding_x }}px;
    border-radius: {{ section.settings.button_radius }}px;
    font-size: {{ section.settings.button_text_size }}px;
    line-height: 1;
    text-decoration: none;
    transition: opacity 180ms ease;
  }

  .text-overlay__button-{{ section_id }}:hover,
  .text-overlay__button-{{ section_id }}:focus {
    opacity: 0.85;
    text-decoration: none;
  }

  .text-overlay__button--primary-{{ section_id }} {
    border: 1px solid {{ section.settings.primary_button_background }};
    background: {{ section.settings.primary_button_background }};
    color: {{ section.settings.primary_button_color }};
  }

  .text-overlay__button--outline-{{ section_id }} {
    border: 1px solid {{ section.settings.outline_button_color }};
    background: transparent;
    color: {{ section.settings.outline_button_color }};
  }

  .text-overlay__button--text-{{ section_id }} {
    min-height: auto;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: {{ section.settings.text_link_color }};
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .text-overlay__spacer-{{ section_id }} {
    height: var(--text-overlay-spacer-height-mobile);
    flex: 0 0 auto;
  }

  .text-overlay__animate-{{ section_id }} {
    animation-duration: 650ms;
    animation-fill-mode: both;
    animation-timing-function: ease;
  }

  .text-overlay__animate--fade-in-{{ section_id }} {
    animation-name: text-overlay-fade-in-{{ section_id }};
  }

  .text-overlay__animate--slide-up-{{ section_id }} {
    animation-name: text-overlay-slide-up-{{ section_id }};
  }

  .text-overlay__animate--scale-in-{{ section_id }} {
    animation-name: text-overlay-scale-in-{{ section_id }};
  }

  @keyframes text-overlay-fade-in-{{ section_id }} {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes text-overlay-slide-up-{{ section_id }} {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes text-overlay-scale-in-{{ section_id }} {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media screen and (min-width: 750px) {
    .text-overlay-{{ section_id }} {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }

    .text-overlay__inner-{{ section_id }} {
      max-width: {% if section.settings.width_style == 'contained' %}{{ section.settings.desktop_max_width }}px{% else %}none{% endif %};
      padding: 0 {{ section.settings.side_padding_desktop }}px;
    }

    .text-overlay__layout-{{ section_id }} {
      display: grid;
      gap: {{ section.settings.desktop_gap }}px;
      align-items: center;
    }

    {% if section.settings.desktop_layout == 'image_left' %}
      .text-overlay__layout-{{ section_id }} {
        grid-template-columns: {{ section.settings.desktop_image_width }}% minmax(0, 1fr);
      }
    {% elsif section.settings.desktop_layout == 'content_left' %}
      .text-overlay__layout-{{ section_id }} {
        grid-template-columns: minmax(0, 1fr) {{ section.settings.desktop_image_width }}%;
      }

      .text-overlay__media-{{ section_id }} {
        order: 2;
      }

      .text-overlay__content--desktop-{{ section_id }} {
        order: 1;
      }
    {% else %}
      .text-overlay__layout-{{ section_id }} {
        grid-template-columns: 1fr;
      }
    {% endif %}

    {% if section.settings.image_size_mode == 'custom' %}
      .text-overlay__media-{{ section_id }} {
        height: {{ section.settings.desktop_image_height }}px;
      }
    {% endif %}

    .text-overlay__content-{{ section_id }} {
      position: static;
      max-width: {{ section.settings.desktop_content_max_width }}px;
      transform: none;
    }

    .text-overlay__content--mobile-{{ section_id }} {
      display: none;
    }

    .text-overlay__content--desktop-{{ section_id }} {
      display: flex;
    }

    .text-overlay__heading-{{ section_id }} {
      font-size: var(--text-overlay-heading-size-desktop);
      color: var(--text-overlay-heading-color-desktop, var(--text-overlay-heading-color));
    }

    .text-overlay__text-{{ section_id }} {
      font-size: var(--text-overlay-text-size-desktop);
      color: var(--text-overlay-text-color-desktop, var(--text-overlay-text-color));
    }

    .text-overlay__icon-title-{{ section_id }} {
      font-size: var(--text-overlay-icon-title-size-desktop);
      color: var(--text-overlay-icon-title-color-desktop, var(--text-overlay-icon-title-color));
    }

    .text-overlay__icon-{{ section_id }} {
      width: var(--text-overlay-icon-size-desktop);
      height: var(--text-overlay-icon-size-desktop);
      flex-basis: var(--text-overlay-icon-size-desktop);
    }

    .text-overlay__spacer-{{ section_id }} {
      height: var(--text-overlay-spacer-height-desktop);
    }

    .text-overlay__button-{{ section_id }} {
      color: var(--text-overlay-button-desktop-color, currentColor);
    }

    .text-overlay__button--outline-{{ section_id }} {
      border-color: var(--text-overlay-button-desktop-border-color, var(--text-overlay-button-desktop-color, {{ section.settings.outline_button_color }}));
      color: var(--text-overlay-button-desktop-color, {{ section.settings.outline_button_color }});
    }

    .text-overlay__button--text-{{ section_id }} {
      color: var(--text-overlay-button-desktop-color, {{ section.settings.text_link_color }});
    }
  }
{% endstyle %}

<div class="text-overlay-{{ section_id }}">
  <div class="text-overlay__inner-{{ section_id }}">
    <div class="text-overlay__layout-{{ section_id }}">
      <div class="text-overlay__media-{{ section_id }}">
        {% if desktop_image != blank %}
          <picture>
            {% if mobile_image != blank %}
              <source media="(max-width: 749px)" srcset="{{ mobile_image | image_url: width: 900 }}">
            {% endif %}
            {{ desktop_image | image_url: width: 1800 | image_tag: class: image_class, loading: 'lazy' }}
          </picture>
        {% else %}
          {{ 'image' | placeholder_svg_tag: placeholder_class }}
        {% endif %}

        {% if section.settings.mobile_content_layout == 'overlay' %}
          <div class="text-overlay__content-{{ section_id }} text-overlay__content--mobile-{{ section_id }}">
            {% for block in section.blocks %}
              {% if block.settings.show_block %}
                {% liquid
                  assign animation_class = ''
                  unless block.settings.animation == blank or block.settings.animation == 'none'
                    assign animation_class = ' text-overlay__animate-' | append: section_id | append: ' text-overlay__animate--' | append: block.settings.animation | append: '-' | append: section_id
                  endunless
                %}

                {% case block.type %}
                  {% when 'heading' %}
                    <div
                      class="text-overlay__heading-{{ section_id }}{{ animation_class }}"
                      style="--text-overlay-heading-color: {{ block.settings.color }}; --text-overlay-heading-color-desktop: {{ block.settings.desktop_color | default: block.settings.color }}; --text-overlay-heading-size-mobile: {{ block.settings.mobile_size }}px; --text-overlay-heading-size-desktop: {{ block.settings.desktop_size }}px;"
                      {{ block.shopify_attributes }}
                    >
                      {{ block.settings.heading }}
                    </div>

                  {% when 'text' %}
                    <div
                      class="text-overlay__text-{{ section_id }}{{ animation_class }}"
                      style="--text-overlay-text-color: {{ block.settings.color }}; --text-overlay-text-color-desktop: {{ block.settings.desktop_color | default: block.settings.color }}; --text-overlay-text-size-mobile: {{ block.settings.mobile_size }}px; --text-overlay-text-size-desktop: {{ block.settings.desktop_size }}px;"
                      {{ block.shopify_attributes }}
                    >
                      {{ block.settings.text }}
                    </div>

                  {% when 'icon_item' %}
                    <div
                      class="text-overlay__icon-item-{{ section_id }}"
                      style="--text-overlay-icon-size-mobile: {{ block.settings.mobile_icon_size }}px; --text-overlay-icon-size-desktop: {{ block.settings.desktop_icon_size }}px; --text-overlay-icon-max-width: {{ block.settings.max_width }}px; --text-overlay-icon-title-color: {{ block.settings.title_color }}; --text-overlay-icon-title-color-desktop: {{ block.settings.desktop_title_color | default: block.settings.title_color }}; --text-overlay-icon-title-size-mobile: {{ block.settings.mobile_title_size }}px; --text-overlay-icon-title-size-desktop: {{ block.settings.desktop_title_size }}px;"
                      {{ block.shopify_attributes }}
                    >
                      <span class="text-overlay__icon-{{ section_id }}" aria-hidden="true">
                        {% if block.settings.icon != blank %}
                          {{ block.settings.icon | image_url: width: 160 | image_tag: loading: 'lazy' }}
                        {% else %}
                          <span class="text-overlay__icon-fallback-{{ section_id }}"></span>
                        {% endif %}
                      </span>
                      <div class="text-overlay__icon-copy-{{ section_id }}">
                        {% if block.settings.title != blank %}
                          <div class="text-overlay__icon-title-{{ section_id }}">{{ block.settings.title }}</div>
                        {% endif %}
                      </div>
                    </div>

                  {% when 'button' %}
                    {% if block.settings.label != blank %}
                      <a
                        class="text-overlay__button-{{ section_id }} text-overlay__button--{{ block.settings.style }}-{{ section_id }}{{ animation_class }}"
                        style="--text-overlay-button-desktop-color: {{ block.settings.desktop_text_color }}; --text-overlay-button-desktop-border-color: {{ block.settings.desktop_border_color }};"
                        href="{{ block.settings.link | default: '#' }}"
                        {{ block.shopify_attributes }}
                      >
                        {{ block.settings.label }}
                      </a>
                    {% endif %}

                  {% when 'spacer' %}
                    <div
                      class="text-overlay__spacer-{{ section_id }}"
                      style="--text-overlay-spacer-height-mobile: {{ block.settings.mobile_height }}px; --text-overlay-spacer-height-desktop: {{ block.settings.desktop_height }}px;"
                      {{ block.shopify_attributes }}
                    ></div>
                {% endcase %}
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <div class="text-overlay__content-{{ section_id }} text-overlay__content--desktop-{{ section_id }}">
        {% for block in section.blocks %}
          {% if block.settings.show_block %}
            {% liquid
              assign animation_class = ''
              unless block.settings.animation == blank or block.settings.animation == 'none'
                assign animation_class = ' text-overlay__animate-' | append: section_id | append: ' text-overlay__animate--' | append: block.settings.animation | append: '-' | append: section_id
              endunless
            %}

            {% case block.type %}
              {% when 'heading' %}
                <div
                  class="text-overlay__heading-{{ section_id }}{{ animation_class }}"
                  style="--text-overlay-heading-color: {{ block.settings.color }}; --text-overlay-heading-color-desktop: {{ block.settings.desktop_color | default: block.settings.color }}; --text-overlay-heading-size-mobile: {{ block.settings.mobile_size }}px; --text-overlay-heading-size-desktop: {{ block.settings.desktop_size }}px;"
                  {{ block.shopify_attributes }}
                >
                  {{ block.settings.heading }}
                </div>

              {% when 'text' %}
                <div
                  class="text-overlay__text-{{ section_id }}{{ animation_class }}"
                  style="--text-overlay-text-color: {{ block.settings.color }}; --text-overlay-text-color-desktop: {{ block.settings.desktop_color | default: block.settings.color }}; --text-overlay-text-size-mobile: {{ block.settings.mobile_size }}px; --text-overlay-text-size-desktop: {{ block.settings.desktop_size }}px;"
                  {{ block.shopify_attributes }}
                >
                  {{ block.settings.text }}
                </div>

              {% when 'icon_item' %}
                <div
                  class="text-overlay__icon-item-{{ section_id }}"
                  style="--text-overlay-icon-size-mobile: {{ block.settings.mobile_icon_size }}px; --text-overlay-icon-size-desktop: {{ block.settings.desktop_icon_size }}px; --text-overlay-icon-max-width: {{ block.settings.max_width }}px; --text-overlay-icon-title-color: {{ block.settings.title_color }}; --text-overlay-icon-title-color-desktop: {{ block.settings.desktop_title_color | default: block.settings.title_color }}; --text-overlay-icon-title-size-mobile: {{ block.settings.mobile_title_size }}px; --text-overlay-icon-title-size-desktop: {{ block.settings.desktop_title_size }}px;"
                  {{ block.shopify_attributes }}
                >
                  <span class="text-overlay__icon-{{ section_id }}" aria-hidden="true">
                    {% if block.settings.icon != blank %}
                      {{ block.settings.icon | image_url: width: 160 | image_tag: loading: 'lazy' }}
                    {% else %}
                      <span class="text-overlay__icon-fallback-{{ section_id }}"></span>
                    {% endif %}
                  </span>
                  <div class="text-overlay__icon-copy-{{ section_id }}">
                    {% if block.settings.title != blank %}
                      <div class="text-overlay__icon-title-{{ section_id }}">{{ block.settings.title }}</div>
                    {% endif %}
                  </div>
                </div>

              {% when 'button' %}
                {% if block.settings.label != blank %}
                  <a
                    class="text-overlay__button-{{ section_id }} text-overlay__button--{{ block.settings.style }}-{{ section_id }}{{ animation_class }}"
                    style="--text-overlay-button-desktop-color: {{ block.settings.desktop_text_color }}; --text-overlay-button-desktop-border-color: {{ block.settings.desktop_border_color }};"
                    href="{{ block.settings.link | default: '#' }}"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.label }}
                  </a>
                {% endif %}

              {% when 'spacer' %}
                <div
                  class="text-overlay__spacer-{{ section_id }}"
                  style="--text-overlay-spacer-height-mobile: {{ block.settings.mobile_height }}px; --text-overlay-spacer-height-desktop: {{ block.settings.desktop_height }}px;"
                  {{ block.shopify_attributes }}
                ></div>
            {% endcase %}
          {% endif %}
        {% endfor %}
      </div>

      {% if section.settings.mobile_content_layout == 'below' %}
        <div class="text-overlay__content-{{ section_id }} text-overlay__content--mobile-{{ section_id }}">
          {% for block in section.blocks %}
            {% if block.settings.show_block %}
              {% liquid
                assign animation_class = ''
                unless block.settings.animation == blank or block.settings.animation == 'none'
                  assign animation_class = ' text-overlay__animate-' | append: section_id | append: ' text-overlay__animate--' | append: block.settings.animation | append: '-' | append: section_id
                endunless
              %}

              {% case block.type %}
                {% when 'heading' %}
                  <div
                    class="text-overlay__heading-{{ section_id }}{{ animation_class }}"
                    style="--text-overlay-heading-color: {{ block.settings.color }}; --text-overlay-heading-color-desktop: {{ block.settings.desktop_color | default: block.settings.color }}; --text-overlay-heading-size-mobile: {{ block.settings.mobile_size }}px; --text-overlay-heading-size-desktop: {{ block.settings.desktop_size }}px;"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.heading }}
                  </div>

                {% when 'text' %}
                  <div
                    class="text-overlay__text-{{ section_id }}{{ animation_class }}"
                    style="--text-overlay-text-color: {{ block.settings.color }}; --text-overlay-text-color-desktop: {{ block.settings.desktop_color | default: block.settings.color }}; --text-overlay-text-size-mobile: {{ block.settings.mobile_size }}px; --text-overlay-text-size-desktop: {{ block.settings.desktop_size }}px;"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.text }}
                  </div>

                {% when 'icon_item' %}
                  <div
                    class="text-overlay__icon-item-{{ section_id }}"
                    style="--text-overlay-icon-size-mobile: {{ block.settings.mobile_icon_size }}px; --text-overlay-icon-size-desktop: {{ block.settings.desktop_icon_size }}px; --text-overlay-icon-max-width: {{ block.settings.max_width }}px; --text-overlay-icon-title-color: {{ block.settings.title_color }}; --text-overlay-icon-title-color-desktop: {{ block.settings.desktop_title_color | default: block.settings.title_color }}; --text-overlay-icon-title-size-mobile: {{ block.settings.mobile_title_size }}px; --text-overlay-icon-title-size-desktop: {{ block.settings.desktop_title_size }}px;"
                    {{ block.shopify_attributes }}
                  >
                    <span class="text-overlay__icon-{{ section_id }}" aria-hidden="true">
                      {% if block.settings.icon != blank %}
                        {{ block.settings.icon | image_url: width: 160 | image_tag: loading: 'lazy' }}
                      {% else %}
                        <span class="text-overlay__icon-fallback-{{ section_id }}"></span>
                      {% endif %}
                    </span>
                    <div class="text-overlay__icon-copy-{{ section_id }}">
                      {% if block.settings.title != blank %}
                        <div class="text-overlay__icon-title-{{ section_id }}">{{ block.settings.title }}</div>
                      {% endif %}
                    </div>
                  </div>

                {% when 'button' %}
                  {% if block.settings.label != blank %}
                    <a
                      class="text-overlay__button-{{ section_id }} text-overlay__button--{{ block.settings.style }}-{{ section_id }}{{ animation_class }}"
                      style="--text-overlay-button-desktop-color: {{ block.settings.desktop_text_color }}; --text-overlay-button-desktop-border-color: {{ block.settings.desktop_border_color }};"
                      href="{{ block.settings.link | default: '#' }}"
                      {{ block.shopify_attributes }}
                    >
                      {{ block.settings.label }}
                    </a>
                  {% endif %}

                {% when 'spacer' %}
                  <div
                    class="text-overlay__spacer-{{ section_id }}"
                    style="--text-overlay-spacer-height-mobile: {{ block.settings.mobile_height }}px; --text-overlay-spacer-height-desktop: {{ block.settings.desktop_height }}px;"
                    {{ block.shopify_attributes }}
                  ></div>
              {% endcase %}
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Text Overlay",
  "tag": "section",
  "class": "section-text-overlay",
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "select",
      "id": "image_size_mode",
      "label": "Image size",
      "options": [
        { "value": "auto", "label": "Auto" },
        { "value": "custom", "label": "Custom height" }
      ],
      "default": "auto"
    },
    {
      "type": "range",
      "id": "mobile_image_height",
      "label": "Mobile image height",
      "min": 200,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 420
    },
    {
      "type": "range",
      "id": "desktop_image_height",
      "label": "Desktop image height",
      "min": 240,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 520
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        { "value": "cover", "label": "Cover" },
        { "value": "contain", "label": "Contain" }
      ],
      "default": "cover"
    },
    {
      "type": "range",
