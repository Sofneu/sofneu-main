{% liquid
  assign section_id = section.id | replace: '_', '' | downcase
  assign main_image_class = 'icon-info-image__main-image-' | append: section_id
  assign main_placeholder_class = 'icon-info-image__main-placeholder-' | append: section_id
  assign icon_class = 'icon-info-image__icon-' | append: section_id
%}

{% style %}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.section_background }};
  }

  .icon-info-image-{{ section_id }} {
    display: block;
    width: 100%;
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    overflow: hidden;
  }

  .icon-info-image-{{ section_id }} * {
    box-sizing: border-box;
  }

  .icon-info-image__inner-{{ section_id }} {
    position: relative;
    width: 100%;
    max-width: {{ section.settings.mobile_max_width }}px;
    min-height: {{ section.settings.mobile_image_size }}px;
    margin: 0 auto;
  }

  .icon-info-image__visual-{{ section_id }} {
    position: relative;
    width: 100%;
    height: {{ section.settings.mobile_image_size }}px;
    overflow: hidden;
    border-radius: {{ section.settings.image_radius_mobile }}px;
    background: #f4f0e8;
  }

  .icon-info-image__main-image-{{ section_id }},
  .icon-info-image__main-placeholder-{{ section_id }} {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.image_position }};
  }

  .icon-info-image__main-placeholder-{{ section_id }} {
    background: #f3f3f3;
  }

  .icon-info-image__content-{{ section_id }} {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 15px;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 17px;
  }

  .icon-info-image__title-{{ section_id }} {
    width: 100%;
    margin: 0;
    color: {{ section.settings.title_color }};
    font-size: {{ section.settings.title_size_mobile }}px;
    line-height: 1.4;
    letter-spacing: -0.02em;
    font-weight: 700;
    text-align: center;
    text-transform: capitalize;
  }

  .icon-info-image__items-{{ section_id }} {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 21px;
    width: 100%;
  }

  .icon-info-image__item-{{ section_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    width: 87px;
    text-align: center;
  }

  .icon-info-image__item-{{ section_id }}:nth-child(3) {
    width: 105px;
  }

  .icon-info-image__icon-wrap-{{ section_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    width: {{ section.settings.icon_size_mobile }}px;
    height: {{ section.settings.icon_size_mobile }}px;
    flex: 0 0 {{ section.settings.icon_size_mobile }}px;
    overflow: hidden;
    border-radius: {{ section.settings.icon_radius }}px;
    background: transparent;
  }

  .icon-info-image__icon-{{ section_id }} {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .icon-info-image__icon-placeholder-{{ section_id }} {
    width: 54%;
    height: 54%;
    border-radius: 50%;
    background: {{ section.settings.icon_placeholder_color }};
  }

  .icon-info-image__item-text-{{ section_id }} {
    width: 100%;
    min-width: 0;
  }

  .icon-info-image__label-{{ section_id }} {
    margin: 0 0 4px;
    color: {{ section.settings.label_color }};
    font-size: {{ section.settings.label_size_mobile }}px;
    line-height: 1.4;
    letter-spacing: -0.02em;
    font-weight: 400;
  }

  .icon-info-image__description-{{ section_id }} {
    margin: 0;
    color: {{ section.settings.description_color }};
    font-size: {{ section.settings.description_size_mobile }}px;
    line-height: 1.4;
    letter-spacing: -0.02em;
    font-weight: 400;
  }

  @media screen and (min-width: 750px) {
    .icon-info-image-{{ section_id }} {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }

    .icon-info-image__inner-{{ section_id }} {
      display: grid;
      grid-template-columns: minmax(360px, {{ section.settings.desktop_image_width }}px) minmax(420px, 560px);
      align-items: center;
      justify-content: center;
      gap: {{ section.settings.desktop_gap }}px;
      max-width: {{ section.settings.desktop_max_width }}px;
      min-height: 0;
    }

    .icon-info-image__visual-{{ section_id }} {
      width: 100%;
      height: {{ section.settings.desktop_image_height }}px;
      border-radius: {{ section.settings.image_radius_desktop }}px;
    }

    .icon-info-image__content-{{ section_id }} {
      position: static;
      align-items: flex-start;
      gap: 34px;
    }

    .icon-info-image__title-{{ section_id }} {
      font-size: {{ section.settings.title_size_desktop }}px;
      text-align: left;
      white-space: nowrap;
    }

    .icon-info-image__items-{{ section_id }} {
      flex-direction: column;
      gap: 28px;
      align-items: stretch;
      justify-content: flex-start;
    }

    .icon-info-image__item-{{ section_id }},
    .icon-info-image__item-{{ section_id }}:nth-child(3) {
      flex-direction: row;
      align-items: flex-start;
      gap: 16px;
      width: 100%;
      text-align: left;
    }

    .icon-info-image__icon-wrap-{{ section_id }} {
      width: {{ section.settings.icon_size_desktop }}px;
      height: {{ section.settings.icon_size_desktop }}px;
      flex-basis: {{ section.settings.icon_size_desktop }}px;
    }

    .icon-info-image__label-{{ section_id }} {
      margin-bottom: 7px;
      font-size: {{ section.settings.label_size_desktop }}px;
    }

    .icon-info-image__description-{{ section_id }} {
      font-size: {{ section.settings.description_size_desktop }}px;
    }
  }
{% endstyle %}

<section class="icon-info-image-{{ section_id }}">
  <div class="icon-info-image__inner-{{ section_id }}">
    <div class="icon-info-image__visual-{{ section_id }}">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1200 | image_tag: class: main_image_class, loading: 'lazy' }}
      {% else %}
        {{ 'image' | placeholder_svg_tag: main_placeholder_class }}
      {% endif %}
    </div>

    <div class="icon-info-image__content-{{ section_id }}">
      {% if section.settings.title != blank %}
        <h2 class="icon-info-image__title-{{ section_id }}">{{ section.settings.title }}</h2>
      {% endif %}

      <div class="icon-info-image__items-{{ section_id }}">
        {% for index in (1..3) %}
          {% liquid
            assign icon_key = 'icon_' | append: index
            assign label_key = 'label_' | append: index
            assign description_key = 'description_' | append: index
            assign item_icon = section.settings[icon_key]
            assign item_label = section.settings[label_key]
            assign item_description = section.settings[description_key]
          %}

          {% if item_icon != blank or item_label != blank or item_description != blank %}
            <div class="icon-info-image__item-{{ section_id }}">
              <div class="icon-info-image__icon-wrap-{{ section_id }}">
                {% if item_icon != blank %}
                  {{ item_icon | image_url: width: 160 | image_tag: class: icon_class, loading: 'lazy' }}
                {% else %}
                  <span class="icon-info-image__icon-placeholder-{{ section_id }}"></span>
                {% endif %}
              </div>

              <div class="icon-info-image__item-text-{{ section_id }}">
                {% if item_label != blank %}
                  <p class="icon-info-image__label-{{ section_id }}">{{ item_label }}</p>
                {% endif %}

                {% if item_description != blank %}
                  <p class="icon-info-image__description-{{ section_id }}">{{ item_description | newline_to_br }}</p>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

