{% liquid
  assign section_id = section.id | replace: '_', '' | downcase
  assign date_format = 'blogs.article.date_format' | t
  assign image_class = 'blog-gallery__image-' | append: section_id
  assign placeholder_class = 'blog-gallery__placeholder-' | append: section_id
  assign hero_image_class = 'blog-gallery__hero-image-' | append: section_id
  assign hero_placeholder_class = 'blog-gallery__hero-placeholder-' | append: section_id
  assign image_sizes = '(min-width: 750px) ' | append: section.settings.image_width_desktop | append: 'px, ' | append: section.settings.image_width_mobile | append: 'px'
  assign hero_sizes = '(min-width: 750px) ' | append: section.settings.content_width | append: 'px, 100vw'
%}

{% style %}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.background_color }};
  }

  .blog-gallery-{{ section_id }} * {
    box-sizing: border-box;
  }

  .blog-gallery__inner-{{ section_id }} {
    max-width: {{ section.settings.content_width }}px;
    margin: 0 auto;
    padding: {{ section.settings.padding_top_mobile }}px 16px {{ section.settings.padding_bottom_mobile }}px;
  }

  .blog-gallery__heading-{{ section_id }} {
    margin: 0 0 {{ section.settings.row_gap_mobile }}px;
    color: #000;
    font-family: Inter, Arial, sans-serif;
    font-size: 16px;
    font-weight: 400;
    line-height: 140%;
    letter-spacing: -0.32px;
    text-transform: capitalize;
    text-align: center;
  }

  .blog-gallery__list-{{ section_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.row_gap_mobile }}px;
  }

  .blog-gallery__hero-item-{{ section_id }} {
    display: block;
    overflow: hidden;
    border-radius: {{ section.settings.image_radius }}px;
    background: #f6f6f6;
  }

  .blog-gallery__hero-wrap-{{ section_id }} {
    aspect-ratio: var(--bg-ratio, 4 / 3);
  }

  .blog-gallery__hero-image-{{ section_id }},
  .blog-gallery__hero-placeholder-{{ section_id }} {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  .blog-gallery__hero-item-{{ section_id }}:hover .blog-gallery__hero-image-{{ section_id }} {
    transform: scale(1.02);
  }

  .blog-gallery__item-{{ section_id }} {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    color: inherit;
    text-decoration: none;
  }

  .blog-gallery__item-{{ section_id }}:hover,
  .blog-gallery__item-{{ section_id }}:focus {
    color: inherit;
    text-decoration: none;
  }

  .blog-gallery__image-wrap-{{ section_id }} {
    flex: 0 0 {{ section.settings.image_width_mobile }}px;
    width: {{ section.settings.image_width_mobile }}px;
    aspect-ratio: var(--bg-ratio, 1 / 1);
    overflow: hidden;
    border-radius: {{ section.settings.image_radius }}px;
    background: #f6f6f6;
  }

  .blog-gallery__image-{{ section_id }},
  .blog-gallery__placeholder-{{ section_id }} {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  .blog-gallery__item-{{ section_id }}:hover .blog-gallery__image-{{ section_id }} {
    transform: scale(1.04);
  }

  .blog-gallery__content-{{ section_id }} {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .blog-gallery__meta-{{ section_id }} {
    color: rgba(43, 43, 43, 0.7);
    font-family: Arial, sans-serif;
    font-size: 10px;
    font-weight: 400;
    line-height: 140%;
    letter-spacing: -0.2px;
    text-transform: capitalize;
  }

  .blog-gallery__title-{{ section_id }} {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    overflow-wrap: anywhere;
    color: {{ section.settings.text_color }};
    font-family: Arial, sans-serif;
    font-size: 14px;
    font-weight: 400;
    line-height: 140%;
    letter-spacing: -0.28px;
    text-transform: capitalize;
  }

  .blog-gallery__item-{{ section_id }}:hover .blog-gallery__title-{{ section_id }} {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media screen and (min-width: 750px) {
    .blog-gallery__inner-{{ section_id }} {
      padding: {{ section.settings.padding_top_desktop }}px 24px {{ section.settings.padding_bottom_desktop }}px;
    }

    .blog-gallery__heading-{{ section_id }} {
      margin-bottom: {{ section.settings.row_gap_desktop }}px;
    }

    .blog-gallery__list-{{ section_id }} {
      gap: {{ section.settings.row_gap_desktop }}px;
    }

    .blog-gallery__item-{{ section_id }} {
      gap: 20px;
    }

    .blog-gallery__image-wrap-{{ section_id }} {
      flex-basis: {{ section.settings.image_width_desktop }}px;
      width: {{ section.settings.image_width_desktop }}px;
    }
  }
{% endstyle %}

{% # theme-check-disable RemoteAsset %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400&display=swap" rel="stylesheet">
{% # theme-check-enable RemoteAsset %}

<div class="blog-gallery-{{ section_id }}">
  <div class="blog-gallery__inner-{{ section_id }}">
    {% if section.settings.heading != blank %}
      <h2 class="blog-gallery__heading-{{ section_id }}">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    <div class="blog-gallery__list-{{ section_id }}">
      {% for block in section.blocks %}
        {% liquid
          assign article = block.settings.article
          assign image = block.settings.image
          if image == blank
            assign image = article.image
          endif

          assign fallback_src = blank
          if image == blank and article != blank
            assign img_tags = article.content | split: '<img'
            if img_tags.size > 1
              assign after_img = img_tags[1] | split: 'src="'
              if after_img.size > 1
                assign fallback_src = after_img[1] | split: '"' | first
                assign src_prefix = fallback_src | slice: 0, 2
                if src_prefix == '//'
                  assign fallback_src = fallback_src | prepend: 'https:'
                endif
              endif
            endif
          endif

          if forloop.first
            case section.settings.hero_image_ratio
              when 'square'
                assign item_ratio = '1 / 1'
              when 'portrait'
                assign item_ratio = '3 / 4'
              when 'landscape'
                assign item_ratio = '4 / 3'
              else
                assign item_ratio = image.aspect_ratio | default: 1.333
            endcase
          else
            case section.settings.image_ratio
              when 'square'
                assign item_ratio = '1 / 1'
              when 'portrait'
                assign item_ratio = '3 / 4'
              when 'landscape'
                assign item_ratio = '4 / 3'
              else
                assign item_ratio = image.aspect_ratio | default: 1
            endcase
          endif
        %}

        {% if forloop.first %}
          {% if article != blank %}
            <a class="blog-gallery__hero-item-{{ section_id }}" href="{{ article.url }}" {{ block.shopify_attributes }}>
          {% else %}
            <div class="blog-gallery__hero-item-{{ section_id }}" {{ block.shopify_attributes }}>
          {% endif %}

            <div class="blog-gallery__hero-wrap-{{ section_id }}" style="--bg-ratio: {{ item_ratio }};">
              {% if image != blank %}
                {{
                  image
                  | image_url: width: 1600
                  | image_tag:
                    class: hero_image_class,
                    widths: '400, 600, 800, 1200, 1600',
                    sizes: hero_sizes,
                    loading: 'lazy'
                }}
              {% elsif fallback_src != blank %}
                {% # theme-check-disable RemoteAsset %}
                <img
                  class="{{ hero_image_class }}"
                  src="{{ fallback_src }}"
                  alt="{{ article.title | escape }}"
                  width="1600"
                  height="1200"
                  loading="lazy"
                >
                {% # theme-check-enable RemoteAsset %}
              {% else %}
                {{ 'lifestyle-1' | placeholder_svg_tag: hero_placeholder_class }}
              {% endif %}
            </div>

          {% if article != blank %}
            </a>
          {% else %}
            </div>
          {% endif %}
        {% else %}
          {% if article != blank %}
            <a class="blog-gallery__item-{{ section_id }}" href="{{ article.url }}" {{ block.shopify_attributes }}>
          {% else %}
            <div class="blog-gallery__item-{{ section_id }}" {{ block.shopify_attributes }}>
          {% endif %}

            <div class="blog-gallery__image-wrap-{{ section_id }}" style="--bg-ratio: {{ item_ratio }};">
              {% if image != blank %}
                {{
                  image
                  | image_url: width: 800
                  | image_tag:
                    class: image_class,
                    widths: '200, 400, 600, 800',
                    sizes: image_sizes,
                    loading: 'lazy'
                }}
              {% elsif fallback_src != blank %}
                {% # theme-check-disable RemoteAsset %}
                <img
                  class="{{ image_class }}"
                  src="{{ fallback_src }}"
                  alt="{{ article.title | escape }}"
                  width="800"
                  height="600"
                  loading="lazy"
                >
                {% # theme-check-enable RemoteAsset %}
              {% else %}
                {{ 'image' | placeholder_svg_tag: placeholder_class }}
              {% endif %}
            </div>

            <div class="blog-gallery__content-{{ section_id }}">
              {% if section.settings.show_date %}
                <span class="blog-gallery__meta-{{ section_id }}">
                  {% if article != blank %}
                    {{ article.published_at | date: date_format }}
                  {% else %}
                    {{ 'now' | date: date_format }}
                  {% endif %}
                </span>
              {% endif %}

              <span class="blog-gallery__title-{{ section_id }}">
                {% if article != blank %}
                  {{ article.title | escape }}
                {% else %}
                  {{ 'sections.featured_blog.onboarding_title' | t }}
                {% endif %}
              </span>
            </div>

          {% if article != blank %}
            </a>
          {% else %}
            </div>
          {% endif %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Blog Gallery",
  "tag": "section",
  "class": "section-blog-gallery",
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Blog Gallery"
    },
    {
      "type": "header",
      "content": "Article display"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "paragraph",
      "content": "The first post fills a full row with its image only. The remaining posts are listed below with image on the left and date + title on the right."
    },
    {
      "type": "select",
      "id": "hero_image_ratio",
      "label": "First post image ratio",
      "options": [
        { "value": "square", "label": "Square (1:1)" },
        { "value": "portrait", "label": "Portrait (3:4)" },
        { "value": "landscape", "label": "Landscape (4:3)" },
        { "value": "adapt", "label": "Adapt to image" }
      ],
      "default": "landscape"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "List post image ratio",
      "options": [
        { "value": "square", "label": "Square (1:1)" },
        { "value": "portrait", "label": "Portrait (3:4)" },
        { "value": "landscape", "label": "Landscape (4:3)" },
        { "value": "adapt", "label": "Adapt to image" }
      ],
      "default": "square"
    },
    {
      "type": "range",
      "id": "image_width_mobile",
      "label": "List image width - mobile",
      "min": 80,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 110
    },
    {
      "type": "range",
      "id": "image_width_desktop",
      "label": "List image width - desktop",
      "min": 120,
      "max": 320,
      "step": 4,
      "unit": "px",
      "default": 200
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "row_gap_mobile",
      "label": "Row spacing - mobile",
      "min": 4,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "row_gap_desktop",
      "label": "Row spacing - desktop",
      "min": 4,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 600,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 900
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Title color",
      "default": "#2b2b2b"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding - mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding - mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top padding - desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding - desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Blog post",
      "settings": [
        {
          "type": "article",
          "id": "article",
          "label": "Article",
          "info": "Image, date and title are pulled from the selected article automatically. The first post is displayed as a full-width image."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image",
          "info": "Optional. Replaces the article's featured image."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Blog Gallery",
      "category": "t:sections.categories.blog",
      "blocks": [
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
