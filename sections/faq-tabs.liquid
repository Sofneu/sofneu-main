{% liquid
  assign section_id = section.id | replace: '_', '' | downcase
%}

{% style %}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.section_background }};
  }

  .faq-tabs-{{ section_id }} {
    width: 100%;
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  .faq-tabs-{{ section_id }} * {
    box-sizing: border-box;
  }

  .faq-tabs__inner-{{ section_id }} {
    width: 100%;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 {{ section.settings.side_padding_mobile }}px;
  }

  .faq-tabs__heading-{{ section_id }} {
    margin: 0 0 {{ section.settings.heading_spacing }}px;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size_mobile }}px;
    line-height: 1.4;
    letter-spacing: {{ section.settings.heading_letter_spacing | divided_by: 100.0 }}em;
    text-align: {{ section.settings.heading_alignment }};
    font-weight: {{ section.settings.heading_weight }};
  }

  .faq-tabs__tabs-{{ section_id }} {
    display: {% if section.settings.show_tabs %}flex{% else %}none{% endif %};
    gap: {{ section.settings.tab_gap }}px;
    width: 100%;
    margin-bottom: {{ section.settings.tabs_spacing }}px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .faq-tabs__tabs-{{ section_id }}::-webkit-scrollbar {
    display: none;
  }

  .faq-tabs__tab-{{ section_id }} {
    flex: 0 0 auto;
    min-height: {{ section.settings.tab_height }}px;
    padding: 0 {{ section.settings.tab_padding_x }}px;
    border: {{ section.settings.tab_border_thickness }}px solid {{ section.settings.tab_border_color }};
    border-radius: {{ section.settings.tab_radius }}px;
    background: {{ section.settings.tab_background }};
    color: {{ section.settings.tab_color }};
    font-size: {{ section.settings.tab_size_mobile }}px;
    letter-spacing: {{ section.settings.tab_letter_spacing | divided_by: 100.0 }}em;
    line-height: 1;
    cursor: pointer;
    white-space: nowrap;
  }

  .faq-tabs__tab-{{ section_id }}:hover,
  .faq-tabs__tab-{{ section_id }}:focus,
  .faq-tabs__tab-{{ section_id }}:focus-visible {
    background: {{ section.settings.tab_background }};
    color: {{ section.settings.tab_color }};
    box-shadow: none;
    opacity: 1;
    outline: none;
  }

  .faq-tabs__tab-{{ section_id }}.is-active {
    background: {{ section.settings.active_tab_background }};
    border-color: {{ section.settings.active_tab_border_color }};
    color: {{ section.settings.active_tab_color }};
  }

  .faq-tabs__list-{{ section_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.item_gap }}px;
  }

  .faq-tabs__item-{{ section_id }} {
    display: none;
    overflow: hidden;
    border: {{ section.settings.closed_border_thickness }}px solid {{ section.settings.closed_border_color }};
    border-radius: {{ section.settings.item_radius }}px;
    background: {{ section.settings.closed_background }};
    transition: background-color 200ms ease, border-color 200ms ease;
  }

  .faq-tabs__item-{{ section_id }}.is-visible {
    display: block;
  }

  .faq-tabs__item-{{ section_id }}.is-open {
    border-color: {{ section.settings.open_border_color }};
    background: {{ section.settings.open_background }};
  }

  .faq-tabs__trigger-{{ section_id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: {{ section.settings.closed_item_height }}px;
    gap: {{ section.settings.title_icon_gap }}px;
    padding: {{ section.settings.item_padding_y }}px {{ section.settings.item_padding_x }}px;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    text-align: left;
  }

  .faq-tabs__trigger-{{ section_id }}:hover,
  .faq-tabs__trigger-{{ section_id }}:focus,
  .faq-tabs__trigger-{{ section_id }}:focus-visible {
    background: transparent;
    box-shadow: none;
    color: inherit;
    opacity: 1;
    outline: none;
    text-decoration: none;
  }

  .faq-tabs__question-wrap-{{ section_id }} {
    display: flex;
    align-items: flex-start;
    min-width: 0;
    gap: {{ section.settings.question_icon_gap }}px;
  }

  .faq-tabs__question-icon-{{ section_id }} {
    display: {% if section.settings.show_question_icon %}inline-flex{% else %}none{% endif %};
    align-items: center;
    justify-content: center;
    width: {{ section.settings.question_icon_size }}px;
    height: {{ section.settings.question_icon_size }}px;
    flex: 0 0 {{ section.settings.question_icon_size }}px;
    margin-top: 2px;
    border-radius: 999px;
    background: {{ section.settings.question_icon_background }};
    color: {{ section.settings.question_icon_color }};
    font-size: {{ section.settings.question_icon_text_size }}px;
    line-height: 1;
  }

  .faq-tabs__question-{{ section_id }} {
    margin: 0;
    min-width: 0;
    color: {{ section.settings.question_color }};
    font-size: {{ section.settings.question_size_mobile }}px;
    line-height: 1.4;
    letter-spacing: {{ section.settings.question_letter_spacing | divided_by: 100.0 }}em;
    font-weight: {{ section.settings.question_weight }};
  }

  .faq-tabs__chevron-{{ section_id }} {
    display: inline-flex;
    width: {{ section.settings.chevron_size }}px;
    height: {{ section.settings.chevron_size }}px;
    flex: 0 0 {{ section.settings.chevron_size }}px;
    color: {{ section.settings.chevron_color }};
    transition: transform 220ms ease;
  }

  .faq-tabs__item-{{ section_id }}.is-open .faq-tabs__chevron-{{ section_id }} {
    transform: rotate(180deg);
  }

  .faq-tabs__panel-{{ section_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 260ms ease;
  }

  .faq-tabs__answer-{{ section_id }} {
    padding: 0 {{ section.settings.answer_padding_x }}px {{ section.settings.answer_padding_bottom }}px;
    color: {{ section.settings.answer_color }};
    font-size: {{ section.settings.answer_size_mobile }}px;
    line-height: {{ section.settings.answer_line_height | divided_by: 100.0 }};
    letter-spacing: {{ section.settings.answer_letter_spacing | divided_by: 100.0 }}em;
  }

  .faq-tabs__answer-{{ section_id }} > *:first-child {
    margin-top: 0;
  }

  .faq-tabs__answer-{{ section_id }} > *:last-child {
    margin-bottom: 0;
  }

  @media screen and (min-width: 750px) {
    .faq-tabs-{{ section_id }} {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }

    .faq-tabs__inner-{{ section_id }} {
      padding: 0 {{ section.settings.side_padding_desktop }}px;
    }

    .faq-tabs__heading-{{ section_id }} {
      font-size: {{ section.settings.heading_size_desktop }}px;
    }

    .faq-tabs__tab-{{ section_id }} {
      font-size: {{ section.settings.tab_size_desktop }}px;
    }

    .faq-tabs__question-{{ section_id }} {
      font-size: {{ section.settings.question_size_desktop }}px;
    }

    .faq-tabs__answer-{{ section_id }} {
      font-size: {{ section.settings.answer_size_desktop }}px;
    }
  }
{% endstyle %}

<div
  class="faq-tabs-{{ section_id }}"
  data-faq-tabs
  data-default-tab="{{ section.settings.default_tab }}"
  data-allow-multiple="{{ section.settings.allow_multiple_open }}"
>
  <div class="faq-tabs__inner-{{ section_id }}">
    {% if section.settings.heading != blank %}
      <h2 class="faq-tabs__heading-{{ section_id }}">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <div class="faq-tabs__tabs-{{ section_id }}" role="tablist" aria-label="{{ section.settings.heading | escape }}">
      {% for i in (1..4) %}
        {% liquid
          assign tab_id = 'tab_' | append: i
          assign label_setting = tab_id | append: '_label'
          assign tab_label = section.settings[label_setting]
        %}
        {% if tab_label != blank %}
          <button
            class="faq-tabs__tab-{{ section_id }}"
            type="button"
            role="tab"
            data-faq-tab="{{ tab_id }}"
            aria-selected="false"
          >
            {{ tab_label }}
          </button>
        {% endif %}
      {% endfor %}
    </div>

    <div class="faq-tabs__list-{{ section_id }}">
      {% for block in section.blocks %}
        {% if block.settings.show_item %}
          {% liquid
            assign panel_id = 'FaqTabsPanel-' | append: section.id | append: '-' | append: block.id
            assign trigger_id = 'FaqTabsTrigger-' | append: section.id | append: '-' | append: block.id
          %}

          <div
            class="faq-tabs__item-{{ section_id }}{% if block.settings.default_open %} is-open{% endif %}"
            data-faq-item
            data-faq-category="{{ block.settings.category }}"
            {{ block.shopify_attributes }}
          >
            <button
              id="{{ trigger_id }}"
              class="faq-tabs__trigger-{{ section_id }}"
              type="button"
              aria-expanded="{% if block.settings.default_open %}true{% else %}false{% endif %}"
              aria-controls="{{ panel_id }}"
              data-faq-trigger
            >
              <span class="faq-tabs__question-wrap-{{ section_id }}">
                <span class="faq-tabs__question-icon-{{ section_id }}" aria-hidden="true">
                  {{ section.settings.question_icon_text }}
                </span>
                <span class="faq-tabs__question-{{ section_id }}">
                  {{ block.settings.question }}
                </span>
              </span>
              <span class="faq-tabs__chevron-{{ section_id }}" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </button>

            <div
              id="{{ panel_id }}"
              class="faq-tabs__panel-{{ section_id }}"
              role="region"
              aria-labelledby="{{ trigger_id }}"
              data-faq-panel
            >
              <div class="faq-tabs__answer-{{ section_id }}">
                {{ block.settings.answer }}
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

<script>
  (() => {
    const initFaqTabs = (root = document) => {
      root.querySelectorAll('[data-faq-tabs]').forEach((section) => {
        if (section.dataset.initialized === 'true') return;
        section.dataset.initialized = 'true';

        const allowMultiple = section.dataset.allowMultiple === 'true';
        const tabs = Array.from(section.querySelectorAll('[data-faq-tab]'));
        const items = Array.from(section.querySelectorAll('[data-faq-item]'));

        const setItem = (item, open) => {
          const trigger = item.querySelector('[data-faq-trigger]');
          const panel = item.querySelector('[data-faq-panel]');

          item.classList.toggle('is-open', open);
          trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
          panel.style.maxHeight = open ? `${panel.scrollHeight}px` : '0px';
        };

        const getActiveTab = () => {
          const defaultTab = section.dataset.defaultTab;
          const matchingTab = tabs.find((tab) => tab.dataset.faqTab === defaultTab);
          return matchingTab ? matchingTab.dataset.faqTab : tabs[0]?.dataset.faqTab || 'tab_1';
        };

        const setTab = (category) => {
          tabs.forEach((tab) => {
            const active = tab.dataset.faqTab === category;
            tab.classList.toggle('is-active', active);
            tab.setAttribute('aria-selected', active ? 'true' : 'false');
          });

          let foundOpen = false;
          items.forEach((item) => {
            const visible = !tabs.length || item.dataset.faqCategory === category;
            item.classList.toggle('is-visible', visible);

            if (!visible) {
              setItem(item, false);
              return;
            }

            if (!allowMultiple) {
              const shouldOpen = item.classList.contains('is-open') && !foundOpen;
              foundOpen = foundOpen || shouldOpen;
              setItem(item, shouldOpen);
            } else {
              setItem(item, item.classList.contains('is-open'));
            }
          });
        };

        tabs.forEach((tab) => {
          tab.addEventListener('click', () => setTab(tab.dataset.faqTab));
        });

        items.forEach((item) => {
          const trigger = item.querySelector('[data-faq-trigger]');
          trigger.addEventListener('click', () => {
            const willOpen = !item.classList.contains('is-open');

            if (!allowMultiple) {
              items.forEach((otherItem) => {
                if (otherItem !== item && otherItem.classList.contains('is-visible')) setItem(otherItem, false);
              });
            }

            setItem(item, willOpen);
          });
        });

        window.addEventListener('resize', () => {
          items.forEach((item) => {
            if (item.classList.contains('is-open')) setItem(item, true);
          });
        });

        setTab(getActiveTab());
      });
    };

    document.addEventListener('DOMContentLoaded', () => initFaqTabs());
    document.addEventListener('shopify:section:load', (event) => initFaqTabs(event.target));
    initFaqTabs();
  })();
</script>

