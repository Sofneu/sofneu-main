{% liquid
  assign section_id = section.id | replace: '_', '' | downcase
  assign image_class = 'shop-category__image-' | append: section_id
  assign placeholder_class = 'shop-category__placeholder-' | append: section_id
%}

{% style %}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.section_background }};
  }

  .shop-category-{{ section_id }} {
    width: 100%;
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  .shop-category-{{ section_id }} * {
    box-sizing: border-box;
  }

  .shop-category__inner-{{ section_id }} {
    width: 100%;
    max-width: {% if section.settings.width_style == 'contained' %}{{ section.settings.mobile_max_width }}px{% else %}none{% endif %};
    margin: 0 auto;
    padding: 0 {{ section.settings.side_padding_mobile }}px;
  }

  .shop-category__heading-{{ section_id }} {
    margin: 0 0 {{ section.settings.heading_spacing }}px;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size_mobile }}px;
    line-height: 1.4;
    letter-spacing: {{ section.settings.heading_letter_spacing | divided_by: 100.0 }}em;
    text-align: center;
    font-weight: 400;
  }

  .shop-category__grid-{{ section_id }} {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: {{ section.settings.gap }}px;
  }

  .shop-category__card-{{ section_id }} {
    position: relative;
    display: block;
    overflow: hidden;
    min-width: 0;
    border-radius: {{ section.settings.image_radius }}px;
    background: #f6f6f6;
    color: inherit;
    text-decoration: none;
  }

  .shop-category__card-{{ section_id }}:hover,
  .shop-category__card-{{ section_id }}:focus {
    color: inherit;
    text-decoration: none;
  }

  .shop-category__card--wide-{{ section_id }} {
    grid-column: 1 / -1;
    aspect-ratio: {{ section.settings.wide_ratio }};
  }

  .shop-category__card--small-{{ section_id }} {
    aspect-ratio: {{ section.settings.small_ratio }};
  }

  .shop-category__image-{{ section_id }},
  .shop-category__placeholder-{{ section_id }} {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit }};
    object-position: center;
  }

  .shop-category__content-{{ section_id }} {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: {{ section.settings.text_gap }}px;
    padding: {{ section.settings.text_padding_mobile }}px;
    text-align: center;
    pointer-events: none;
  }

  .shop-category__title-{{ section_id }} {
    margin: 0;
    color: {{ section.settings.title_color }};
    font-size: {{ section.settings.title_size_mobile }}px;
    line-height: 1.35;
    letter-spacing: {{ section.settings.title_letter_spacing | divided_by: 100.0 }}em;
    font-weight: 700;
    text-decoration: {% if section.settings.title_underline %}underline{% else %}none{% endif %};
    text-underline-offset: 2px;
  }

  .shop-category__description-{{ section_id }} {
    margin: 0;
    color: {{ section.settings.description_color }};
    font-size: {{ section.settings.description_size_mobile }}px;
    line-height: 1.4;
    letter-spacing: {{ section.settings.description_letter_spacing | divided_by: 100.0 }}em;
  }

  @media screen and (min-width: 750px) {
    .shop-category-{{ section_id }} {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }

    .shop-category__inner-{{ section_id }} {
      max-width: {% if section.settings.width_style == 'contained' %}{{ section.settings.desktop_max_width }}px{% else %}none{% endif %};
      padding: 0 {{ section.settings.side_padding_desktop }}px;
    }

    .shop-category__heading-{{ section_id }} {
      font-size: {{ section.settings.heading_size_desktop }}px;
    }

    .shop-category__content-{{ section_id }} {
      padding: {{ section.settings.text_padding_desktop }}px;
    }

    .shop-category__title-{{ section_id }} {
      font-size: {{ section.settings.title_size_desktop }}px;
    }

    .shop-category__description-{{ section_id }} {
      font-size: {{ section.settings.description_size_desktop }}px;
    }
  }
{% endstyle %}

<div class="shop-category-{{ section_id }}">
  <div class="shop-category__inner-{{ section_id }}">
    {% if section.settings.heading != blank %}
      <h2 class="shop-category__heading-{{ section_id }}">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="shop-category__grid-{{ section_id }}">
      <a class="shop-category__card-{{ section_id }} shop-category__card--wide-{{ section_id }}" href="{{ section.settings.link_1 | default: '#' }}">
        {% if section.settings.image_1 != blank %}
          {{ section.settings.image_1 | image_url: width: 1600 | image_tag: class: image_class, loading: 'lazy' }}
        {% else %}
          {{ 'image' | placeholder_svg_tag: placeholder_class }}
        {% endif %}
        <div class="shop-category__content-{{ section_id }}">
          {% if section.settings.title_1 != blank %}
            <p class="shop-category__title-{{ section_id }}">{{ section.settings.title_1 }}</p>
          {% endif %}
          {% if section.settings.description_1 != blank %}
            <p class="shop-category__description-{{ section_id }}">{{ section.settings.description_1 }}</p>
          {% endif %}
        </div>
      </a>

      <a class="shop-category__card-{{ section_id }} shop-category__card--small-{{ section_id }}" href="{{ section.settings.link_2 | default: '#' }}">
        {% if section.settings.image_2 != blank %}
          {{ section.settings.image_2 | image_url: width: 900 | image_tag: class: image_class, loading: 'lazy' }}
        {% else %}
          {{ 'image' | placeholder_svg_tag: placeholder_class }}
        {% endif %}
        <div class="shop-category__content-{{ section_id }}">
          {% if section.settings.title_2 != blank %}
            <p class="shop-category__title-{{ section_id }}">{{ section.settings.title_2 }}</p>
          {% endif %}
          {% if section.settings.description_2 != blank %}
            <p class="shop-category__description-{{ section_id }}">{{ section.settings.description_2 }}</p>
          {% endif %}
        </div>
      </a>

      <a class="shop-category__card-{{ section_id }} shop-category__card--small-{{ section_id }}" href="{{ section.settings.link_3 | default: '#' }}">
        {% if section.settings.image_3 != blank %}
          {{ section.settings.image_3 | image_url: width: 900 | image_tag: class: image_class, loading: 'lazy' }}
        {% else %}
          {{ 'image' | placeholder_svg_tag: placeholder_class }}
        {% endif %}
        <div class="shop-category__content-{{ section_id }}">
          {% if section.settings.title_3 != blank %}
            <p class="shop-category__title-{{ section_id }}">{{ section.settings.title_3 }}</p>
          {% endif %}
          {% if section.settings.description_3 != blank %}
            <p class="shop-category__description-{{ section_id }}">{{ section.settings.description_3 }}</p>
          {% endif %}
        </div>
      </a>
    </div>
  </div>
</div>

